# ---------------------------------------------------------------------------
# ISMS environment configuration
# Copy this file to `.env` and adjust if needed. Every value below already works
# on a default local MongoDB Community Server install on Windows.
# ---------------------------------------------------------------------------

# HTTP port for the Express application
PORT=3000

# development | production
NODE_ENV=development

# MongoDB connection string.
# Local Windows MongoDB  ->  mongodb://127.0.0.1:27017/isms_db
# MongoDB Atlas (free)  ->  mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/isms_db
MONGO_URI=mongodb://127.0.0.1:27017/isms_db

# Secret used to sign the JWT auth cookies. CHANGE THIS for real deployments.
JWT_SECRET=change-this-to-a-long-random-secret-string-for-isms
# JWT lifetime, e.g. 7d / 12h / 60m
JWT_EXPIRES_IN=7d

# Set to true to print password-reset links in the server console when SMTP
# is not configured (strongly recommended for local development).
DEV_SHOW_RESET_LINK=true

# Maximum number of files a single multi-upload field may contain
MAX_FILES_PER_UPLOAD=5

# ---------------------------------------------------------------------------
# SMTP (OPTIONAL) - used for password reset e-mails and application alerts.
# Leave the host blank to run completely offline: e-mails are then printed to
# the server console instead of being sent. The app starts fine without SMTP.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ISMS <no-reply@isms.local>"