<%
/**
 * Modern Career-Tech Opportunity Card Component
 * Compatible with landing page, browse, search, bookmarks, recommendations, and dashboard.
 */
const dl = (typeof o.daysLeft === 'number' ? o.daysLeft : Math.ceil((new Date(o.deadline).getTime() - Date.now()) / 86400000));
const expired = dl < 0;
const badge = format.deadlineBadge(dl);
const cp = o.companyProfile || {};
const companyName = cp.companyName || o.companyNameCopy || 'Hiring Organization';
const initialLetter = companyName.trim().charAt(0).toUpperCase() || 'C';
const alreadyApplied = typeof o.applied !== 'undefined'
  ? o.applied
  : (typeof appliedIds !== 'undefined' && appliedIds ? appliedIds.has(String(o._id)) : false);
const isSaved = typeof bookmarkedIds !== 'undefined' && bookmarkedIds ? bookmarkedIds.has(String(o._id)) : false;
const isInternship = o.type === 'internship';
%>
<div class="card opportunity-card h-100 border-0 shadow-sm transition-hover position-relative">
  <div class="card-body p-4 d-flex flex-column">
    <!-- Header: Company Info + Type Badge -->
    <div class="d-flex justify-content-between align-items-start gap-2 mb-3">
      <div class="d-flex align-items-center gap-3 min-w-0">
        <div class="company-logo-wrapper flex-shrink-0">
          <% if (cp.logo) { %>
            <img src="/files/company/logo/<%= cp.user || '' %>" class="company-logo-img rounded-3" width="46" height="46"
                 style="object-fit:cover" alt="<%= companyName %>"
                 onerror="this.onerror=null; this.parentElement.innerHTML='<span class=\'company-logo-fallback\'><%= initialLetter %></span>';">
          <% } else { %>
            <span class="company-logo-fallback rounded-3"><%= initialLetter %></span>
          <% } %>
        </div>
        <div class="min-w-0">
          <div class="d-flex align-items-center gap-1">
            <span class="company-name text-truncate fw-semibold text-body-secondary small" title="<%= companyName %>">
              <%= companyName %>
            </span>
            <% if (cp.verified) { %>
              <i class="bi bi-patch-check-fill text-primary small" title="Verified Organization" aria-label="Verified"></i>
            <% } %>
          </div>
          <% if (typeof cp.averageRating !== 'undefined' && cp.reviewCount > 0) { %>
            <div class="small text-warning d-flex align-items-center gap-1" style="font-size: 0.75rem;">
              <i class="bi bi-star-fill"></i>
              <span class="fw-bold text-body"><%= cp.averageRating.toFixed(1) %></span>
              <span class="text-muted">(<%= cp.reviewCount %>)</span>
            </div>
          <% } %>
        </div>
      </div>

      <span class="badge badge-subtle <%= isInternship ? 'badge-subtle-indigo' : 'badge-subtle-emerald' %> text-uppercase fw-semibold px-2 py-1">
        <i class="bi <%= isInternship ? 'bi-briefcase-fill' : 'bi-mortarboard-fill' %> me-1"></i><%= isInternship ? 'Internship' : 'Scholarship' %>
      </span>
    </div>

    <!-- Title -->
    <h3 class="card-title h6 fw-bold mb-2">
      <a href="/opportunities/<%= o._id %>" class="text-decoration-none text-body card-title-link stretched-link-target">
        <%= o.title %>
      </a>
    </h3>

    <!-- Meta Details: Location, Mode, Duration -->
    <div class="opportunity-meta-tags d-flex flex-wrap gap-2 mb-3 small text-muted">
      <span class="meta-tag d-inline-flex align-items-center"><i class="bi bi-geo-alt me-1 text-primary"></i><%= o.location || 'Flexible' %></span>
      <span class="meta-tag text-capitalize d-inline-flex align-items-center">
        <i class="bi bi-<%= o.mode === 'remote' ? 'laptop' : o.mode === 'hybrid' ? 'building-gear' : 'building' %> me-1 text-primary"></i><%= o.mode || 'On-site' %>
      </span>
      <% if (o.duration) { %>
        <span class="meta-tag d-inline-flex align-items-center"><i class="bi bi-calendar3 me-1 text-primary"></i><%= o.duration %></span>
      <% } %>
    </div>

    <!-- Description snippet -->
    <p class="small text-body-secondary flex-grow-1 mb-3 line-clamp-2">
      <%= format.truncate(o.description, 120) %>
    </p>

    <!-- Skill Tags -->
    <% if (o.requiredSkills && o.requiredSkills.length) { %>
      <div class="d-flex flex-wrap gap-1 mb-3">
        <% o.requiredSkills.slice(0, 3).forEach(function (s) { %>
          <span class="badge skill-pill"><%= s %></span>
        <% }); %>
        <% if (o.requiredSkills.length > 3) { %>
          <span class="badge skill-pill skill-pill-more">+<%= o.requiredSkills.length - 3 %></span>
        <% } %>
      </div>
    <% } %>

    <!-- Skill Match Bar (if available in student recommendation context) -->
    <% if (typeof o.match !== 'undefined') { %>
      <div class="skill-match-box p-2 rounded-2 mb-3 bg-body-tertiary">
        <div class="d-flex justify-content-between align-items-center small mb-1">
          <span class="text-muted small"><i class="bi bi-bullseye text-primary me-1"></i>Profile Match</span>
          <strong class="text-primary"><%= o.match %>%</strong>
        </div>
        <div class="progress" style="height: 6px;" role="progressbar" aria-valuenow="<%= o.match %>" aria-valuemin="0" aria-valuemax="100">
          <div class="progress-bar bg-gradient-indigo" style="width: <%= o.match %>%;"></div>
        </div>
      </div>
    <% } %>

    <!-- Compensation / Award Highlight -->
    <div class="d-flex justify-content-between align-items-center pt-2 mt-auto border-top border-light-subtle">
      <div class="stipend-badge">
        <span class="text-muted small d-block" style="font-size: 0.72rem;"><%= isInternship ? 'STIPEND' : 'AWARD' %></span>
        <span class="fw-bold text-indigo fs-6">
          <i class="bi bi-currency-dollar text-primary"></i><%= o.stipend ? format.formatNumber(o.stipend) : (isInternship ? 'Unpaid' : 'Merit-based') %>
        </span>
      </div>
      <div class="text-end">
        <span class="badge <%= badge.className %> fw-medium rounded-pill px-2 py-1">
          <i class="bi bi-clock-history me-1"></i><%= badge.text %>
        </span>
      </div>
    </div>
  </div>

  <!-- Card Footer with Actions -->
  <div class="card-footer bg-transparent border-0 px-4 pb-4 pt-0 d-flex justify-content-between align-items-center gap-2">
    <div class="d-flex align-items-center gap-2">
      <% if (o.views !== undefined) { %>
        <span class="small text-muted" title="<%= o.views %> views" style="font-size: 0.78rem;">
          <i class="bi bi-eye text-secondary me-1"></i><%= o.views %>
        </span>
      <% } %>

      <% if (isStudent && !expired) { %>
        <form action="/opportunities/<%= o._id %>/bookmark" method="post" class="d-inline bookmark-form" data-id="<%= o._id %>">
          <button type="submit" class="btn btn-sm btn-bookmark <%= isSaved ? 'active is-saved' : '' %>"
                  title="<%= isSaved ? 'Saved to bookmarks' : 'Save opportunity' %>"
                  aria-label="<%= isSaved ? 'Remove bookmark' : 'Bookmark' %>">
            <i class="bi <%= isSaved ? 'bi-bookmark-heart-fill text-danger' : 'bi-bookmark' %>"></i>
          </button>
        </form>
      <% } %>
    </div>

    <div class="card-action-btn">
      <% if (alreadyApplied) { %>
        <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 fw-semibold">
          <i class="bi bi-check2-circle me-1"></i>Applied
        </span>
      <% } else if (!expired && o.status === 'approved') { %>
        <a class="btn btn-sm btn-indigo px-3" href="/opportunities/<%= o._id %>">
          View &amp; Apply <i class="bi bi-arrow-right ms-1"></i>
        </a>
      <% } else if (expired) { %>
        <span class="badge text-bg-secondary px-3 py-2">Closed</span>
      <% } %>
    </div>
  </div>
</div>
