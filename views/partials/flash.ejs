<% if (typeof flashes !== 'undefined' && flashes && flashes.length) { %>
  <div class="container mt-3 flash-container" id="flashContainer">
    <% flashes.forEach(function (f) { %>
      <div class="alert alert-<%= f.type %> alert-dismissible fade show shadow-sm d-flex align-items-start gap-2" role="alert">
        <i class="bi <%= f.type === 'success' ? 'bi-check-circle-fill' : f.type === 'error' ? 'bi-exclamation-octagon-fill' : f.type === 'warning' ? 'bi-exclamation-triangle-fill' : 'bi-info-circle-fill' %> mt-1"></i>
        <div class="flex-grow-1"><%= f.msg %></div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    <% }); %>
  </div>
<% } %>