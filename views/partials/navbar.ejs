<% const navLinks = [
     { href: '/opportunities', label: 'Browse', icon: 'bi-grid' },
     { href: '/search?type=internship', label: 'Internships', icon: 'bi-briefcase' },
     { href: '/search?type=scholarship', label: 'Scholarships', icon: 'bi-mortarboard' },
     { href: '/companies', label: 'Companies', icon: 'bi-building' }
   ]; %>

<nav class="navbar navbar-expand-lg sticky-top isms-navbar">
  <div class="container">
    <a class="navbar-brand fw-bold d-flex align-items-center gap-2" href="/">
      <img src="/img/logo.png" alt="NextStep Logo" class="navbar-logo">
      <span class="brand-text">Next<span class="brand-text-accent">Step</span></span>
    </a>

    <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
            aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="mainNav">
      <ul class="navbar-nav me-auto mb-2 mb-lg-0 ps-lg-3">
        <% navLinks.forEach(function (link) { %>
          <li class="nav-item">
            <a class="nav-link <%= originalUrl === link.href ? 'active' : '' %>" href="<%= link.href %>">
              <i class="bi <%= link.icon %> me-1.5 opacity-75"></i><%= link.label %>
            </a>
          </li>
        <% }); %>

        <% if (currentUser) { %>
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle <%= currentPath.startsWith('/student') || currentPath.startsWith('/company') || currentPath.startsWith('/admin') ? 'active' : '' %>"
               href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
              <i class="bi bi-speedometer2 me-1.5 opacity-75"></i>Portal
            </a>
            <ul class="dropdown-menu shadow-lg border-0 rounded-3 py-2">
              <% if (isStudent) { %>
                <li><a class="dropdown-item py-2" href="/student/dashboard"><i class="bi bi-speedometer2 me-2 text-indigo"></i>My Dashboard</a></li>
                <li><a class="dropdown-item py-2" href="/student/profile"><i class="bi bi-person-badge me-2 text-indigo"></i>My Profile</a></li>
                <li><a class="dropdown-item py-2" href="/student/applications"><i class="bi bi-send-check me-2 text-indigo"></i>My Applications</a></li>
                <li><a class="dropdown-item py-2" href="/student/bookmarks"><i class="bi bi-bookmark-heart me-2 text-indigo"></i>Saved Opportunities</a></li>
              <% } else if (isCompany) { %>
                <li><a class="dropdown-item py-2" href="/company/dashboard"><i class="bi bi-speedometer2 me-2 text-indigo"></i>Dashboard</a></li>
                <li><a class="dropdown-item py-2" href="/company/opportunities"><i class="bi bi-briefcase me-2 text-indigo"></i>My Postings</a></li>
                <li><a class="dropdown-item py-2" href="/company/applications"><i class="bi bi-people me-2 text-indigo"></i>Applicants</a></li>
                <li><a class="dropdown-item py-2" href="/company/profile"><i class="bi bi-building me-2 text-indigo"></i>Company Profile</a></li>
              <% } else if (isAdmin) { %>
                <li><a class="dropdown-item py-2" href="/admin/dashboard"><i class="bi bi-speedometer2 me-2 text-indigo"></i>Admin Dashboard</a></li>
                <li><a class="dropdown-item py-2" href="/admin/users"><i class="bi bi-people me-2 text-indigo"></i>User Management</a></li>
                <li><a class="dropdown-item py-2" href="/admin/opportunities"><i class="bi bi-clipboard-check me-2 text-indigo"></i>Moderation Queue</a></li>
                <li><a class="dropdown-item py-2" href="/admin/analytics"><i class="bi bi-graph-up me-2 text-indigo"></i>Platform Analytics</a></li>
              <% } %>
            </ul>
          </li>
        <% } %>
      </ul>

      <!-- Navbar Search -->
      <form class="d-none d-xl-block me-3" action="/search" method="get" role="search">
        <div class="input-group input-group-sm isms-search-compact">
          <span class="input-group-text bg-transparent border-0"><i class="bi bi-search text-white-50"></i></span>
          <input type="search" class="form-control border-0 bg-transparent text-white" name="q"
                 placeholder="Search jobs, skills, companies..."
                 value="<%= typeof query.q !== 'undefined' ? query.q : '' %>" aria-label="Search" autocomplete="off">
        </div>
      </form>

      <div class="d-flex align-items-center gap-2">
        <!-- Dark / Light theme toggle -->
        <button class="btn btn-sm btn-nav-icon theme-toggle" id="themeToggle" type="button"
                title="Switch between dark and light mode" aria-label="Toggle dark mode">
          <i class="bi bi-moon-stars-fill"></i>
        </button>

        <% if (currentUser) { %>
          <!-- Notification Bell -->
          <a class="btn btn-sm btn-nav-icon position-relative" href="/notifications" title="Notifications" aria-label="Notifications">
            <i class="bi bi-bell-fill"></i>
            <% if (unreadCount > 0) { %>
              <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" id="unreadBadge">
                <%= unreadCount > 99 ? '99+' : unreadCount %>
              </span>
            <% } %>
          </a>

          <!-- User Menu -->
          <div class="dropdown">
            <a class="btn btn-sm btn-nav-user dropdown-toggle d-flex align-items-center gap-2" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
              <span class="avatar avatar-sm rounded-circle"><%= currentUser.initials %></span>
              <span class="d-none d-md-inline text-truncate" style="max-width:130px"><%= currentUser.name.split(' ')[0] %></span>
            </a>
            <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 rounded-3 py-2">
              <li class="px-3 py-2 border-bottom">
                <div class="fw-bold text-dark"><%= currentUser.name %></div>
                <div class="small text-muted text-truncate"><%= currentUser.email %></div>
                <span class="badge badge-subtle badge-subtle-indigo mt-1 text-uppercase"><%= currentUser.role %></span>
              </li>
              <li><a class="dropdown-item py-2" href="/auth/settings"><i class="bi bi-gear me-2 text-secondary"></i>Account Settings</a></li>
              <% if (isCompany) { %>
                <li><a class="dropdown-item py-2" href="/company/profile"><i class="bi bi-building me-2 text-secondary"></i>Company Profile</a></li>
              <% } %>
              <% if (isStudent) { %>
                <li><a class="dropdown-item py-2" href="/student/profile"><i class="bi bi-person-badge me-2 text-secondary"></i>My Profile</a></li>
              <% } %>
              <li><hr class="dropdown-divider my-1"></li>
              <li>
                <form action="/auth/logout" method="post" class="px-1 m-0">
                  <button type="submit" class="dropdown-item py-2 text-danger"><i class="bi bi-box-arrow-right me-2"></i>Sign out</button>
                </form>
              </li>
            </ul>
          </div>
        <% } else { %>
          <a class="btn btn-sm btn-nav-ghost px-3" href="/auth/login">Sign in</a>
          <a class="btn btn-sm btn-gradient-indigo px-3 shadow-sm" href="/auth/register">Get Started</a>
        <% } %>
      </div>
    </div>
  </div>
</nav>
