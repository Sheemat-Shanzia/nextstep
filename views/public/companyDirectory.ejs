<%- include('../partials/flash') %>
<div class="container py-4">
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
      <h1 class="h3 mb-1"><i class="bi bi-buildings me-2 text-primary"></i>Company directory</h1>
      <p class="text-body-secondary mb-0">Every organisation posting internships and scholarships on NextStep.</p>
    </div>
  </div>

  <div class="card shadow-sm border-0 mb-4">
    <div class="card-body">
      <form action="/companies" method="get" class="row g-2 align-items-end">
        <div class="col-lg-8 col-md-9">
          <label class="form-label small mb-1" for="q">Search companies</label>
          <input type="search" class="form-control form-control-sm" id="q" name="q" value="<%= search %>" placeholder="Company name or industry">
        </div>
        <div class="col-lg-4 col-md-3">
          <button class="btn btn-primary btn-sm w-100" type="submit"><i class="bi bi-search me-1"></i>Search</button>
        </div>
      </form>
    </div>
  </div>

  <% if (!companies.length) { %>
    <%- include('../partials/emptyState', {
      emptyState: {
        icon: 'bi-buildings',
        title: 'No companies found',
        message: 'Try a different search term, or register your company to start posting opportunities.',
        actionHref: '/auth/register?role=company', actionLabel: 'Register a company', actionIcon: 'bi-plus-lg'
      }
    }) %>
  <% } else { %>
    <div class="row g-4">
      <% companies.forEach(function (c) { %>
        <div class="col-md-6 col-xl-4">
          <div class="card h-100 shadow-sm">
            <div class="card-body">
              <div class="d-flex align-items-start gap-3 mb-3">
                <div class="company-logo-wrapper flex-shrink-0" style="width: 52px; height: 52px; border: 0; background: transparent;">
                  <% if (c.logo) { %>
                    <img src="/files/company/logo/<%= c.user %>" width="52" height="52" class="rounded-3"
                         style="object-fit:cover" alt="<%= c.companyName %> logo"
                         onerror="this.onerror=null; this.parentElement.innerHTML='<%- format.getLogoFallbackHtml(c, { type: 'company', size: 52, borderRadius: 12 }) %>';">
                  <% } else { %>
                    <%- format.renderCategoryIcon(c, { type: 'company', size: 52, borderRadius: 12 }) %>
                  <% } %>
                </div>
                <div class="min-w-0">
                  <h2 class="h6 mb-1">
                    <a href="/companies/<%= c.user %>" class="text-decoration-none text-body"><%= c.companyName %></a>
                  </h2>
                  <div class="small text-body-secondary"><%= c.industry || 'Industry not specified' %></div>
                  <div class="mt-1">
                    <% if (c.verified) { %>
                      <span class="badge text-bg-primary-subtle text-primary border border-primary-subtle"><i class="bi bi-patch-check-fill me-1"></i>Verified</span>
                    <% } %>
                    <% if (c.reviewCount > 0) { %>
                      <span class="badge text-bg-warning"><i class="bi bi-star-fill"></i> <%= c.averageRating.toFixed(1) %></span>
                    <% } %>
                  </div>
                </div>
              </div>

              <p class="small text-body-secondary"><%= format.truncate(c.description, 130) %></p>

              <div class="d-flex justify-content-between align-items-center small">
                <span class="text-body-secondary"><i class="bi bi-geo-alt me-1"></i><%= c.location || 'Location not specified' %></span>
                <span class="badge text-bg-primary"><%= c.openCount %> open</span>
              </div>
            </div>
            <div class="card-footer bg-transparent">
              <a class="btn btn-sm btn-outline-primary w-100" href="/companies/<%= c.user %>">
                View company page
              </a>
            </div>
          </div>
        </div>
      <% }); %>
    </div>

    <%- include('../partials/pagination', { pager: pager }) %>
  <% } %>
</div>