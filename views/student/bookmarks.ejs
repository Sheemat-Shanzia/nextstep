<%- include('../partials/flash') %>
<div class="container py-4">
  <nav aria-label="breadcrumb">
    <ol class="breadcrumb small">
      <li class="breadcrumb-item"><a href="/student/dashboard">Dashboard</a></li>
      <li class="breadcrumb-item active">Saved opportunities</li>
    </ol>
  </nav>

  <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
      <h1 class="h3 mb-1"><i class="bi bi-bookmark-heart me-2 text-primary"></i>Saved opportunities</h1>
      <p class="text-body-secondary mb-0">Everything you bookmarked, in one list.</p>
    </div>
    <a class="btn btn-outline-secondary" href="/search"><i class="bi bi-search me-1"></i>Find more</a>
  </div>

  <% if (!bookmarks.length) { %>
    <%- include('../partials/emptyState', {
      emptyState: {
        icon: 'bi-bookmark-heart',
        title: 'You have not saved any opportunity yet',
        message: 'Click the bookmark icon on any opportunity card or detail page to save it for later.',
        actionHref: '/opportunities', actionLabel: 'Browse opportunities', actionIcon: 'bi-grid'
      }
    }) %>
  <% } else { %>
    <div class="row g-4">
      <% bookmarks.forEach(function (b) { %>
        <div class="col-md-6 col-xl-4">
          <%- include('../partials/opportunityCard', { o: b.opportunity }) %>
        </div>
      <% }); %>
    </div>

    <%- include('../partials/pagination', { pager: pager }) %>
  <% } %>
</div>