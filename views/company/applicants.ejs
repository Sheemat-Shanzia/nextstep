<%- include('../partials/flash') %>
<div class="container py-4">
  <nav aria-label="breadcrumb">
    <ol class="breadcrumb small">
      <li class="breadcrumb-item"><a href="/company/opportunities">My opportunities</a></li>
      <li class="breadcrumb-item"><a href="/company/opportunities/<%= opportunity._id %>"><%= format.truncate(opportunity.title, 28) %></a></li>
      <li class="breadcrumb-item active">Applicants</li>
    </ol>
  </nav>

  <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
      <h1 class="h3 mb-1"><i class="bi bi-people me-2 text-primary"></i>Applicants</h1>
      <p class="text-body-secondary mb-0">
        <%= opportunity.title %> &middot; <%= totalApplicants %> application<%= totalApplicants === 1 ? '' : 's' %>
      </p>
    </div>
    <div class="d-flex gap-2">
      <a class="btn btn-outline-secondary" href="/company/applications/export.csv?opportunityId=<%= opportunity._id %>">
        <i class="bi bi-filetype-csv me-1"></i>Export CSV
      </a>
      <a class="btn btn-primary" href="/company/opportunities/<%= opportunity._id %>"><i class="bi bi-arrow-left me-1"></i>Back to post</a>
    </div>
  </div>

  <!-- filter tabs -->
  <div class="d-flex flex-wrap gap-2 mb-3">
    <a class="btn btn-sm <%= !activeStatus ? 'btn-dark' : 'btn-outline-secondary' %>" href="/company/opportunities/<%= opportunity._id %>/applicants">
      All <span class="badge bg-light text-dark ms-1"><%= totalApplicants %></span>
    </a>
    <% Object.keys(statusLabel).forEach(function (s) { %>
      <% if (s === 'submitted' || s === 'withdrawn') { return; } %>
      <a class="btn btn-sm <%= activeStatus === s ? 'btn-dark' : 'btn-outline-secondary' %>"
         href="/company/opportunities/<%= opportunity._id %>/applicants?status=<%= s %>">
        <%= statusLabel[s] %> <span class="badge bg-light text-dark ms-1"><%= counts[s] || 0 %></span>
      </a>
    <% }); %>
  </div>

  <% if (!applications.length) { %>
    <%- include('../partials/emptyState', {
      emptyState: {
        icon: 'bi-people',
        title: activeStatus ? `No ${statusLabel[activeStatus] || activeStatus} applicants` : 'No applicants yet',
        message: activeStatus ? 'Try a different status filter.' : 'Once this post is approved and students start applying, they will appear here.',
        actionHref: '/company/opportunities/' + opportunity._id,
        actionLabel: 'Back to post', actionIcon: 'bi-arrow-left'
      }
    }) %>
  <% } else { %>
    <div class="card shadow-sm border-0 table-card">
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead>
              <tr>
                <th style="width:36px">
                  <input class="form-check-input" type="checkbox" id="checkAll" aria-label="Select all">
                </th>
                <th>Student</th>
                <th>University / CGPA</th>
                <th>Skills</th>
                <th>Applied</th>
                <th>Status</th>
                <th class="text-end">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% applications.forEach(function (a) { %>
                <tr>
                  <td>
                    <input class="form-check-input app-check" type="checkbox" value="<%= a._id %>" aria-label="Select applicant">
                  </td>
                    <td>
                      <div class="fw-semibold"><%= a.student ? a.student.name : 'Unknown' %></div>
                      <div class="small text-body-secondary"><%= a.student ? a.student.email : '' %></div>
                    </td>
                    <td class="small">
                      <%= a.profile && a.profile.university ? a.profile.university : '-' %>
                      <% if (a.profile && a.profile.cgpa !== null && a.profile.cgpa !== undefined) { %>
                        <div><span class="badge text-bg-light border">CGPA <%= a.profile.cgpa %></span></div>
                      <% } %>
                    </td>
                    <td class="small" style="max-width:220px">
                      <% if (a.profile && a.profile.skills && a.profile.skills.length) { %>
                        <div class="kbd-list">
                          <% a.profile.skills.slice(0, 3).forEach(function (s) { %>
                            <span class="badge text-bg-light border"><%= s.name %></span>
                          <% }); %>
                          <% if (a.profile.skills.length > 3) { %>
                            <span class="badge text-bg-light border">+<%= a.profile.skills.length - 3 %></span>
                          <% } %>
                        </div>
                      <% } else { %>-<% } %>
                    </td>
                    <td class="small text-nowrap"><%= format.formatDate(a.appliedAt) %></td>
                    <td>
                      <span class="badge <%= format.APPLICATION_STATUS_BADGE[a.status] %>"><%= format.applicationStatusLabel(a.status) %></span>
                    </td>
                    <td class="text-end">
                      <div class="d-inline-flex gap-1">
                        <a class="btn btn-sm btn-outline-primary" href="/company/applications/<%= a._id %>" title="Review"><i class="bi bi-eye"></i></a>
                        <% if (a.cvPath) { %>
                          <a class="btn btn-sm btn-outline-secondary" href="/files/application/<%= a._id %>/cv" title="Download CV">
                            <i class="bi bi-file-earmark-pdf"></i>
                          </a>
                        <% } %>
                      </div>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        </div>
      </div>

    <!-- bulk bar (bonus 13) -->
    <div class="card shadow-sm border-0 mt-3" id="bulkBar" style="display:none">
      <div class="card-body p-3">
        <form action="/company/applications/bulk-status" method="post" class="row g-2 align-items-end">
          <div id="bulkSelected"></div>
          <div class="col-md-3">
            <label class="form-label small mb-1" for="bulkStatus">Change status of selected</label>
            <select class="form-select form-select-sm" id="bulkStatus" name="status" required>
              <option value="">Choose a status...</option>
              <% statuses.forEach(function (s) { %>
                <option value="<%= s %>"><%= statusLabel[s] %></option>
              <% }); %>
            </select>
          </div>
          <div class="col-md-6">
            <label class="form-label small mb-1" for="bulkNote">Note for the students (optional)</label>
            <input type="text" class="form-control form-control-sm" id="bulkNote" name="note" maxlength="2000"
                   placeholder="e.g. Shortlisted for the technical round">
          </div>
          <div class="col-md-3">
            <button class="btn btn-primary btn-sm w-100" type="submit">
              <i class="bi bi-check2-all me-1"></i>Apply to selected
            </button>
          </div>
        </form>
      </div>
    </div>

    <%- include('../partials/pagination', { pager: pager }) %>
  <% } %>
</div>