<%- include('../partials/flash') %>
<div class="container py-4">
  <div class="mb-4">
    <h1 class="h3 mb-1"><i class="bi bi-megaphone me-2 text-primary"></i>Announcements</h1>
    <p class="text-body-secondary mb-0">
      Published announcements appear on the student and company dashboards and generate an in-app notification.
    </p>
  </div>

  <div class="row g-4">
    <div class="col-lg-5">
      <div class="card shadow-sm border-0">
        <div class="card-body p-4">
          <h2 class="h5 mb-3"><i class="bi bi-plus-circle me-2 text-primary"></i>New announcement</h2>

          <form action="/admin/announcements" method="post" class="needs-validation" novalidate>
            <div class="mb-3">
              <label class="form-label" for="title">Title</label>
              <input type="text" class="form-control" id="title" name="title" required minlength="3" maxlength="180"
                     placeholder="e.g. Scholarship results published">
              <div class="invalid-feedback">Title must be at least 3 characters.</div>
            </div>

            <div class="mb-3">
              <label class="form-label" for="body">Message</label>
              <textarea class="form-control" id="body" name="body" rows="4" required minlength="5" maxlength="3000"
                        placeholder="What should the users know?"></textarea>
              <div class="invalid-feedback">Message must be at least 5 characters.</div>
            </div>

            <div class="row g-3 mb-3">
              <div class="col-md-6">
                <label class="form-label" for="level">Level</label>
                <select class="form-select" id="level" name="level">
                  <% levels.forEach(function (l) { %>
                    <option value="<%= l %>" <%= l === 'info' ? 'selected' : '' %>><%= l.charAt(0).toUpperCase() + l.slice(1) %></option>
                  <% }); %>
                </select>
              </div>
              <div class="col-md-6">
                <label class="form-label" for="expiresAt">Expires (optional)</label>
                <input type="date" class="form-control" id="expiresAt" name="expiresAt">
              </div>
            </div>

            <div class="mb-3">
              <label class="form-label">Audience</label>
              <% audiences.forEach(function (a) { %>
                <div class="form-check">
                  <input class="form-check-input" type="checkbox" name="audience" value="<%= a %>" id="aud<%= a %>" checked>
                  <label class="form-check-label small text-capitalize" for="aud<%= a %>"><%= a %><%= a === 'admin' ? 's' : 's' %></label>
                </div>
              <% }); %>
              <div class="form-text">Unchecked roles do not receive the notification.</div>
            </div>

            <button class="btn btn-primary w-100" type="submit">
              <span class="spinner-border spinner-border-sm me-1 d-none" data-loading-spinner></span>
              <i class="bi bi-megaphone me-1"></i>Publish announcement
            </button>
          </form>
        </div>
      </div>
    </div>

    <div class="col-lg-7">
      <div class="card shadow-sm border-0">
        <div class="card-body p-4">
          <h2 class="h5 mb-3"><i class="bi bi-list-ul me-2 text-primary"></i>Published (<%= announcements.length %>)</h2>

          <% if (!announcements.length) { %>
            <p class="text-body-secondary small mb-0">No announcements yet. Publish your first one on the left.</p>
          <% } else { %>
            <div class="d-grid gap-3">
              <% announcements.forEach(function (a) { %>
                <div class="border rounded p-3">
                  <div class="d-flex flex-wrap justify-content-between align-items-start gap-2">
                    <div class="min-w-0">
                      <h3 class="h6 mb-1">
                        <% if (!a.isActive) { %><i class="bi bi-eye-slash text-body-secondary me-1" title="Hidden"></i><% } %>
                        <%= a.title %>
                      </h3>
                      <div class="small text-body-secondary">
                        <%= a.createdByName %> &middot; <%= format.timeAgo(a.createdAt) %>
                        <% if (a.expiresAt) { %> &middot; expires <%= format.formatDate(a.expiresAt) %><% } %>
                      </div>
                    </div>
                    <div class="d-flex gap-1">
                      <span class="badge text-bg-<%= a.level %>"><%= a.level %></span>
                      <span class="badge text-bg-light border text-uppercase"><%= a.isActive ? 'live' : 'hidden' %></span>
                    </div>
                  </div>

                  <p class="small mb-2"><%= a.body %></p>

                  <div class="d-flex flex-wrap gap-2 align-items-center">
                    <div class="kbd-list me-2">
                      <% a.audience.forEach(function (aud) { %>
                        <span class="badge text-bg-light border text-capitalize"><%= aud %></span>
                      <% }); %>
                    </div>
                    <form action="/admin/announcements/<%= a._id %>" method="post" class="d-inline">
                      <input type="hidden" name="action" value="toggle">
                      <button class="btn btn-sm btn-outline-secondary" type="submit">
                        <i class="bi bi-<%= a.isActive ? 'eye-slash' : 'eye' %> me-1"></i><%= a.isActive ? 'Hide' : 'Show' %>
                      </button>
                    </form>
                    <form action="/admin/announcements/<%= a._id %>" method="post" class="d-inline"
                          data-confirm="Delete the announcement &quot;<%= a.title %>&quot;?">
                      <input type="hidden" name="action" value="delete">
                      <button class="btn btn-sm btn-outline-danger" type="submit"><i class="bi bi-trash me-1"></i>Delete</button>
                    </form>
                  </div>
                </div>
              <% }); %>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>