<%- include('../partials/flash') %>
<div class="container py-4">
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
      <h1 class="h3 mb-1"><i class="bi bi-chat-left-text me-2 text-primary"></i>Feedback inbox</h1>
      <p class="text-body-secondary mb-0">Messages submitted through the public contact page.</p>
    </div>
    <a class="btn btn-outline-secondary" href="/feedback" target="_blank" rel="noopener">
      <i class="bi bi-box-arrow-up-right me-1"></i>Open public form
    </a>
  </div>

  <div class="d-flex flex-wrap gap-2 mb-3">
    <a class="btn btn-sm <%= !activeStatus ? 'btn-dark' : 'btn-outline-secondary' %>" href="/admin/feedback">All</a>
    <% ['new', 'seen', 'resolved'].forEach(function (s) { %>
      <a class="btn btn-sm <%= activeStatus === s ? 'btn-dark' : 'btn-outline-secondary' %>" href="/admin/feedback?status=<%= s %>">
        <span class="text-capitalize"><%= s %></span> <span class="badge bg-light text-dark ms-1"><%= counts[s] || 0 %></span>
      </a>
    <% }); %>
  </div>

  <% if (!feedbacks.length) { %>
    <%- include('../partials/emptyState', {
      emptyState: {
        icon: 'bi-chat-left-text',
        title: 'No messages',
        message: 'Feedback submitted by visitors will appear here.',
        actionHref: '/feedback', actionLabel: 'Open contact page', actionIcon: 'bi-send'
      }
    }) %>
  <% } else { %>
    <div class="d-grid gap-3">
      <% feedbacks.forEach(function (f) { %>
        <div class="card shadow-sm border-0">
          <div class="card-body p-4">
            <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-2">
              <div>
                <h2 class="h6 mb-1"><%= f.name %> &mdash; <span class="text-body-secondary small"><%= f.email %></span></h2>
                <div class="small text-body-secondary">
                  <span class="badge text-bg-light border"><%= f.subject %></span>
                  <%= format.formatDateTime(f.createdAt) %> &middot; IP <%= f.ip || '-' %>
                </div>
              </div>
              <span class="badge text-bg-<%= f.status === 'new' ? 'danger' : f.status === 'seen' ? 'warning' : 'success' %> text-capitalize"><%= f.status %></span>
            </div>

            <p class="mb-3" style="white-space: pre-line"><%= f.message %></p>

            <div class="d-flex flex-wrap gap-2">
              <a class="btn btn-sm btn-outline-secondary" href="mailto:<%= f.email %>?subject=Re: <%= encodeURIComponent(f.subject) %>">
                <i class="bi bi-reply me-1"></i>Reply by e-mail
              </a>
              <form action="/admin/feedback/<%= f._id %>" method="post" class="d-inline">
                <input type="hidden" name="action" value="seen">
                <button class="btn btn-sm btn-outline-warning" type="submit"><i class="bi bi-eye me-1"></i>Mark as seen</button>
              </form>
              <form action="/admin/feedback/<%= f._id %>" method="post" class="d-inline">
                <input type="hidden" name="action" value="resolved">
                <button class="btn btn-sm btn-outline-success" type="submit"><i class="bi bi-check2-circle me-1"></i>Resolve</button>
              </form>
              <form action="/admin/feedback/<%= f._id %>" method="post" class="d-inline"
                    data-confirm="Permanently delete this message from <%= f.name %>?">
                <input type="hidden" name="action" value="delete">
                <button class="btn btn-sm btn-outline-danger" type="submit"><i class="bi bi-trash me-1"></i>Delete</button>
              </form>
            </div>
          </div>
        </div>
      <% }); %>
    </div>

    <%- include('../partials/pagination', { pager: pager }) %>
  <% } %>
</div>