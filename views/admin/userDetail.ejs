<%- include('../partials/flash') %>
<%
const isSelf = user._id.toString() === currentUser._id.toString();
%>
<div class="container py-4">
  <nav aria-label="breadcrumb">
    <ol class="breadcrumb small">
      <li class="breadcrumb-item"><a href="/admin/users">Users</a></li>
      <li class="breadcrumb-item active"><%= user.name %></li>
    </ol>
  </nav>

  <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-4">
    <div class="d-flex align-items-center gap-3">
      <span class="avatar avatar-lg"><%= user.initials %></span>
      <div>
        <h1 class="h3 mb-1"><%= user.name %></h1>
        <p class="text-body-secondary mb-1"><%= user.email %></p>
        <div class="d-flex gap-2">
          <span class="badge text-bg-secondary text-uppercase"><%= user.role %></span>
          <span class="badge text-bg-<%= user.status === 'active' ? 'success' : user.status === 'suspended' ? 'danger' : 'warning' %> text-capitalize"><%= user.status %></span>
          <% if (!user.isEmailVerified) { %><span class="badge text-bg-warning">e-mail unverified</span><% } %>
          <% if (isLastAdmin) { %><span class="badge text-bg-info">Last active admin</span><% } %>
        </div>
      </div>
    </div>
    <a class="btn btn-outline-secondary" href="/admin/users"><i class="bi bi-arrow-left me-1"></i>Back to users</a>
  </div>

  <% if (isLastAdmin) { %>
    <div class="alert alert-info">
      <i class="bi bi-info-circle me-1"></i>
      This is the last active administrator account. It cannot be suspended, demoted or deleted.
    </div>
  <% } %>

  <div class="row g-4">
    <div class="col-lg-4">
      <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-4">
          <h2 class="h6 text-uppercase text-body-secondary mb-3">Account information</h2>
          <ul class="list-unstyled small d-grid gap-2 mb-0">
            <li class="d-flex justify-content-between"><span class="text-body-secondary">User ID</span><code class="small"><%= user._id %></code></li>
            <li class="d-flex justify-content-between"><span class="text-body-secondary">Registered</span><span><%= format.formatDateTime(user.createdAt) %></span></li>
            <li class="d-flex justify-content-between"><span class="text-body-secondary">Last login</span><span><%= user.lastLogin ? format.formatDateTime(user.lastLogin) : 'never' %></span></li>
            <li class="d-flex justify-content-between"><span class="text-body-secondary">Updated</span><span><%= format.formatDateTime(user.updatedAt) %></span></li>
          </ul>
        </div>
      </div>

      <!-- role -->
      <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-4">
          <h2 class="h6 text-uppercase text-body-secondary mb-3">Change role</h2>
          <form action="/admin/users/<%= user._id %>" method="post" class="needs-validation" novalidate>
            <input type="hidden" name="action" value="role">
            <input type="hidden" name="returnTo" value="/admin/users/<%= user._id %>">
            <div class="mb-2">
              <label class="form-label small mb-1" for="role">New role</label>
              <select class="form-select form-select-sm" id="role" name="role" required>
                <% ['student', 'company', 'admin'].forEach(function (r) { %>
                  <option value="<%= r %>" <%= user.role === r ? 'selected' : '' %>><%= r.charAt(0).toUpperCase() + r.slice(1) %></option>
                <% }); %>
              </select>
            </div>
            <button class="btn btn-primary btn-sm w-100" type="submit" <%= isLastAdmin ? 'disabled' : '' %>>
              <i class="bi bi-arrow-left-right me-1"></i>Update role
            </button>
            <% if (isLastAdmin) { %><div class="form-text">Disabled: the last admin cannot be demoted.</div><% } %>
          </form>
        </div>
      </div>

      <!-- suspend -->
      <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-4">
          <h2 class="h6 text-uppercase text-body-secondary mb-3">Account status</h2>
          <% if (isSelf) { %>
            <div class="alert alert-secondary small mb-0">You cannot suspend your own account.</div>
          <% } else if (user.status === 'active') { %>
            <p class="small text-body-secondary">Suspending blocks sign-in immediately and hides their content.</p>
            <form action="/admin/users/<%= user._id %>" method="post" data-confirm="Suspend <%= user.name %>?">
              <input type="hidden" name="action" value="suspend">
              <input type="hidden" name="returnTo" value="/admin/users/<%= user._id %>">
              <button class="btn btn-outline-warning w-100" type="submit" <%= isLastAdmin ? 'disabled' : '' %>>
                <i class="bi bi-pause-circle me-1"></i>Suspend account
              </button>
            </form>
          <% } else { %>
            <p class="small text-body-secondary">This account is currently <strong><%= user.status %></strong>.</p>
            <form action="/admin/users/<%= user._id %>" method="post" data-confirm="Reactivate <%= user.name %>?">
              <input type="hidden" name="action" value="activate">
              <input type="hidden" name="returnTo" value="/admin/users/<%= user._id %>">
              <button class="btn btn-outline-success w-100" type="submit">
                <i class="bi bi-play-circle me-1"></i>Reactivate account
              </button>
            </form>
          <% } %>
        </div>
      </div>

      <!-- delete -->
      <div class="card shadow-sm border-0 border-danger">
        <div class="card-body p-4">
          <h2 class="h6 text-uppercase text-danger mb-3">Danger zone</h2>
          <p class="small text-body-secondary">
            Deleting removes the account together with its profile, opportunities, applications,
            bookmarks, reviews and notifications.
          </p>
          <form action="/admin/users/<%= user._id %>" method="post"
                data-confirm="Permanently delete <%= user.name %> and every linked record? This cannot be undone.">
            <input type="hidden" name="action" value="delete">
            <input type="hidden" name="returnTo" value="/admin/users">
            <button class="btn btn-danger w-100" type="submit" <%= (isSelf || isLastAdmin) ? 'disabled' : '' %>>
              <i class="bi bi-trash me-1"></i>Delete user
            </button>
          </form>
        </div>
      </div>
    </div>

    <div class="col-lg-8">
      <!-- student profile -->
      <% if (studentProfile) { %>
        <div class="card shadow-sm border-0 mb-4">
          <div class="card-body p-4">
            <h2 class="h6 text-uppercase text-body-secondary mb-3">Student profile</h2>
            <div class="row g-3">
              <div class="col-6 col-md-4">
                <div class="small text-body-secondary">University</div>
                <div class="fw-semibold"><%= studentProfile.university || '-' %></div>
              </div>
              <div class="col-6 col-md-4">
                <div class="small text-body-secondary">Degree</div>
                <div class="fw-semibold"><%= studentProfile.degree || '-' %></div>
              </div>
              <div class="col-6 col-md-4">
                <div class="small text-body-secondary">CGPA</div>
                <div class="fw-semibold"><%= studentProfile.cgpa ?? '-' %></div>
              </div>
              <div class="col-6 col-md-4">
                <div class="small text-body-secondary">Semester</div>
                <div class="fw-semibold"><%= studentProfile.currentSemester || '-' %></div>
              </div>
              <div class="col-6 col-md-4">
                <div class="small text-body-secondary">Profile strength</div>
                <div class="fw-semibold"><%= studentProfile.profileStrength %>%</div>
              </div>
              <div class="col-6 col-md-4">
                <div class="small text-body-secondary">CV uploaded</div>
                <div class="fw-semibold"><%= studentProfile.cvPath ? 'Yes' : 'No' %></div>
              </div>
              <div class="col-12">
                <div class="small text-body-secondary mb-1">Skills</div>
                <div class="kbd-list">
                  <% if (studentProfile.skills.length) { %>
                    <% studentProfile.skills.forEach(function (s) { %>
                      <span class="badge text-bg-light border"><%= s.name %> (<%= s.level %>)</span>
                    <% }); %>
                  <% } else { %><span class="text-body-secondary small">None</span><% } %>
                </div>
              </div>
            </div>
          </div>
        </div>
      <% } %>

      <!-- company profile -->
      <% if (companyProfile) { %>
        <div class="card shadow-sm border-0 mb-4">
          <div class="card-body p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
              <h2 class="h6 text-uppercase text-body-secondary mb-0">Company profile</h2>
              <% if (companyProfile.verified) { %>
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle"><i class="bi bi-patch-check-fill me-1"></i>Verified</span>
              <% } %>
            </div>
            <div class="row g-3">
              <div class="col-6 col-md-4">
                <div class="small text-body-secondary">Company</div>
                <div class="fw-semibold"><%= companyProfile.companyName %></div>
              </div>
              <div class="col-6 col-md-4">
                <div class="small text-body-secondary">Industry</div>
                <div class="fw-semibold"><%= companyProfile.industry || '-' %></div>
              </div>
              <div class="col-6 col-md-4">
                <div class="small text-body-secondary">Size</div>
                <div class="fw-semibold"><%= companyProfile.size %></div>
              </div>
              <div class="col-12">
                <div class="small text-body-secondary">Rating</div>
                <div class="fw-semibold">
                  <%= companyProfile.averageRating ? companyProfile.averageRating.toFixed(1) : '-' %>
                  <span class="text-body-secondary small">(<%= companyProfile.reviewCount %> reviews)</span>
                </div>
              </div>
            </div>

            <% if (user.role === 'company') { %>
              <form action="/admin/companies/<%= companyProfile._id %>/verify" method="post" class="mt-3"
                    data-confirm="<%= companyProfile.verified ? 'Remove the verified badge from' : 'Verify' %> <%= companyProfile.companyName %>?">
                <input type="hidden" name="returnTo" value="/admin/users/<%= user._id %>">
                <button class="btn btn-sm <%= companyProfile.verified ? 'btn-outline-secondary' : 'btn-primary' %>" type="submit">
                  <i class="bi bi-patch-check me-1"></i><%= companyProfile.verified ? 'Remove verification' : 'Verify company' %>
                </button>
              </form>
            <% } %>
          </div>
        </div>
      <% } %>

      <!-- applications -->
      <% if (user.role === 'student') { %>
        <div class="card shadow-sm border-0 mb-4">
          <div class="card-body p-4">
            <h2 class="h6 text-uppercase text-body-secondary mb-3">Recent applications</h2>
            <% if (!applications.length) { %>
              <p class="small text-body-secondary mb-0">This student has not applied to anything yet.</p>
            <% } else { %>
              <div class="table-responsive">
                <table class="table table-sm table-hover align-middle mb-0">
                  <thead><tr><th>Opportunity</th><th>Type</th><th>Applied</th><th>Status</th></tr></thead>
                  <tbody>
                    <% applications.forEach(function (a) { %>
                      <tr>
                        <td class="small"><%= a.opportunity ? a.opportunity.title : '(removed)' %></td>
                        <td><span class="badge <%= a.opportunity && a.opportunity.type === 'scholarship' ? 'bg-success' : 'bg-primary' %>">
                          <%= a.opportunity ? a.opportunity.type : '-' %></span></td>
                        <td class="small text-nowrap"><%= format.formatDate(a.appliedAt) %></td>
                        <td><span class="badge <%= format.APPLICATION_STATUS_BADGE[a.status] %>"><%= format.applicationStatusLabel(a.status) %></span></td>
                      </tr>
                    <% }); %>
                  </tbody>
                </table>
              </div>
            <% } %>
          </div>
        </div>
      <% } %>

      <!-- company opportunities -->
      <% if (user.role === 'company' && opportunities.length) { %>
        <div class="card shadow-sm border-0 mb-4">
          <div class="card-body p-4">
            <h2 class="h6 text-uppercase text-body-secondary mb-3">Their opportunities (<%= opportunities.length %>)</h2>
            <div class="table-responsive">
              <table class="table table-sm table-hover align-middle mb-0">
                <thead><tr><th>Title</th><th>Deadline</th><th>Status</th><th></th></tr></thead>
                <tbody>
                  <% opportunities.forEach(function (o) { %>
                    <tr>
                      <td class="small"><%= o.title %></td>
                      <td class="small text-nowrap"><%= format.formatDate(o.deadline) %></td>
                      <td><span class="badge <%= format.OPPORTUNITY_STATUS_BADGE[o.status] %> text-capitalize"><%= o.status %></span></td>
                      <td class="text-end">
                        <a class="btn btn-sm btn-outline-secondary" href="/admin/opportunities/<%= o._id %>"><i class="bi bi-eye"></i></a>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      <% } %>

      <!-- activity -->
      <div class="card shadow-sm border-0">
        <div class="card-body p-4">
          <h2 class="h6 text-uppercase text-body-secondary mb-3">Recent activity</h2>
          <% if (!recentActivity.length) { %>
            <p class="small text-body-secondary mb-0">Nothing recorded for this user yet.</p>
          <% } else { %>
            <div class="table-responsive">
              <table class="table table-sm table-hover align-middle mb-0">
                <thead><tr><th>Action</th><th>Details</th><th>IP</th><th>When</th></tr></thead>
                <tbody>
                  <% recentActivity.forEach(function (a) { %>
                    <tr>
                      <td><span class="badge text-bg-light border"><%= a.action %></span></td>
                      <td class="small text-body-secondary"><%= a.details || '-' %></td>
                      <td class="small"><%= a.ip || '-' %></td>
                      <td class="small text-nowrap"><%= format.formatDateTime(a.createdAt) %></td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>