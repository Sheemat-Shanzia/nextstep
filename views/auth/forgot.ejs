<%- include('../partials/flash') %>
<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-lg-5 col-md-8">
      <div class="card shadow-sm border-0">
        <div class="card-body p-4 p-lg-5">
          <div class="text-center mb-4">
            <a href="/" class="d-inline-block mb-3">
              <img src="/img/logo.png" alt="NextStep Logo" class="auth-logo">
            </a>
            <h1 class="h4 mb-1">Forgot your password?</h1>
            <p class="text-body-secondary small">Enter your e-mail and we will send you a reset link.</p>
          </div>

          <% if (typeof devLink !== 'undefined' && devLink) { %>
            <div class="alert alert-warning">
              <div class="fw-semibold mb-1"><i class="bi bi-terminal me-1"></i>Development mode</div>
              <p class="small mb-2">
                SMTP is not configured, so the reset link is shown here (and printed to the server console).
              </p>
              <div class="small">Account: <strong><%= devEmail %></strong></div>
              <a class="btn btn-sm btn-warning mt-2 text-break" href="<%= devLink %>">Open reset link</a>
            </div>
          <% } %>

          <form action="/auth/forgot-password" method="post" class="needs-validation" novalidate>
            <div class="mb-3">
              <label class="form-label" for="email">E-mail address</label>
              <div class="input-group">
                <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                <input type="email" class="form-control" id="email" name="email" required
                       value="<%= typeof oldInput !== 'undefined' ? (oldInput.email || '') : '' %>"
                       placeholder="you@example.com" autocomplete="email">
              </div>
              <div class="invalid-feedback">Please enter a valid e-mail address.</div>
            </div>

            <button class="btn btn-primary w-100" type="submit">
              <span class="spinner-border spinner-border-sm me-1 d-none" data-loading-spinner></span>
              <i class="bi bi-send me-1"></i>Send reset link
            </button>
          </form>

          <p class="text-center small mt-3 mb-0">
            <a href="/auth/login"><i class="bi bi-arrow-left me-1"></i>Back to sign in</a>
          </p>
        </div>
      </div>
    </div>
  </div>
</div>