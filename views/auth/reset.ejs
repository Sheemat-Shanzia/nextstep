<%- include('../partials/flash') %>
<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-lg-5 col-md-8">
      <div class="card shadow-sm border-0">
        <div class="card-body p-4 p-lg-5">
          <div class="text-center mb-4">
            <a href="/" class="d-inline-block mb-3">
              <img src="/img/logo.png" alt="NextStep Logo" class="auth-logo">
            </a>
            <h1 class="h4 mb-1">Choose a new password</h1>
            <p class="text-body-secondary small">Resetting the password for <strong><%= email %></strong></p>
          </div>

          <form action="/auth/reset-password/<%= token %>" method="post" class="needs-validation" novalidate>
            <div class="mb-3">
              <label class="form-label" for="password">New password</label>
              <div class="input-group">
                <span class="input-group-text"><i class="bi bi-lock"></i></span>
                <input type="password" class="form-control" id="password" name="password" required minlength="8"
                       autocomplete="new-password" placeholder="At least 8 characters">
              </div>
              <div class="invalid-feedback">Password must be at least 8 characters.</div>
              <div class="form-text">Must contain a lower case letter, an upper case letter and a number.</div>
            </div>

            <div class="mb-3">
              <label class="form-label" for="password2">Confirm new password</label>
              <div class="input-group">
                <span class="input-group-text"><i class="bi bi-lock-fill"></i></span>
                <input type="password" class="form-control" id="password2" name="password2" required
                       autocomplete="new-password" placeholder="Repeat your new password">
              </div>
              <div class="invalid-feedback">The two passwords do not match.</div>
            </div>

            <button class="btn btn-primary w-100" type="submit">
              <span class="spinner-border spinner-border-sm me-1 d-none" data-loading-spinner></span>
              <i class="bi bi-check2-circle me-1"></i>Update password
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>