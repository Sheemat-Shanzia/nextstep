    <!-- Visual Feature Grid Cards -->
    <div class="col-lg-7">
      <div class="row g-3">
        <div class="col-sm-6">
          <div class="feature-card p-4 rounded-4 bg-white shadow-sm border border-light-subtle h-100 transition-hover">
