<%- include('../partials/flash') %>

<!-- =========================================================================
     1. HERO SECTION (Refined International Career-Tech Aesthetic)
     ========================================================================= -->
<section class="hero-section position-relative overflow-hidden pt-4 pt-lg-5 pb-5">
  <!-- Subtle gradient blur orbs for ambient glow -->
  <div class="hero-gradient-orb hero-orb-1" aria-hidden="true"></div>
  <div class="hero-gradient-orb hero-orb-2" aria-hidden="true"></div>

  <div class="container position-relative z-1 py-lg-2">
    <div class="row align-items-center g-4 g-xl-5">
      <!-- HERO LEFT COLUMN: Announcement, Headline, Subtitle, Search Bar, Trending, CTAs -->
      <div class="col-lg-6 text-center text-lg-start">
        <!-- Small Announcement Badge -->
        <div class="d-inline-flex align-items-center gap-2 px-3 py-1.5 rounded-pill bg-white shadow-sm border border-purple-subtle mb-3 hero-announcement-badge">
          <span class="pulse-indicator bg-purple"></span>
          <span class="small fw-semibold text-purple">Empowering Students &amp; Graduates</span>
          <i class="bi bi-arrow-right text-purple small"></i>
        </div>

        <!-- Main Headline -->
        <h1 class="hero-title fw-extrabold text-navy mb-3 lh-sm">
          Your future starts with the <span class="text-gradient-purple">right opportunity</span>.
        </h1>

        <!-- Subtitle Description -->
        <p class="hero-subtitle text-navy-muted mb-4 pe-xl-2 fs-5">
          Discover internships, unlock scholarships, and take the next step toward your dream career. NextStep brings opportunities from companies and organizations into one place.
        </p>

        <!-- Horizontal Search Component -->
        <div class="hero-search-wrapper bg-white p-2 rounded-4 shadow-sm border border-purple-light mb-4">
          <form class="hero-search d-flex flex-column flex-md-row align-items-stretch gap-2" action="/search" method="get" role="search">
            <div class="input-group input-group-lg border-0 flex-grow-1 align-items-center">
              <span class="input-group-text bg-transparent border-0 text-purple ps-3 pe-2">
                <i class="bi bi-search fs-5"></i>
              </span>
              <input type="search" class="form-control border-0 shadow-none px-2 text-navy" name="q" autocomplete="off" id="heroSearchInput"
                     placeholder="Job title, skill or company..." aria-label="Search opportunities">
            </div>
            <div class="vr d-none d-md-block opacity-25 my-2"></div>
            <select class="form-select border-0 shadow-none text-navy-muted py-2 d-none d-sm-block bg-transparent" name="type" style="max-width: 160px; font-weight: 500;">
              <option value="">All Types</option>
              <option value="internship">Internships</option>
              <option value="scholarship">Scholarships</option>
            </select>
            <button class="btn btn-purple-gradient btn-lg px-4 rounded-3 d-flex align-items-center justify-content-center gap-2 fw-semibold" type="submit">
              <span>Search</span> <i class="bi bi-arrow-right"></i>
            </button>
          </form>
          <div id="heroSuggestions" class="hero-suggestions d-none" role="listbox"></div>
        </div>

        <!-- Trending Skill Tags -->
        <div class="d-flex flex-wrap gap-2 justify-content-center justify-content-lg-start align-items-center mb-4">
          <span class="small text-navy-muted fw-semibold me-1"><i class="bi bi-fire text-danger me-1"></i>Trending:</span>
          <% ['Software Engineering', 'Data Science', 'UI/UX Design', 'Marketing', 'FinTech'].forEach(function (k) { %>
            <a class="badge rounded-pill hero-trending-chip text-decoration-none" href="/search?q=<%= encodeURIComponent(k) %>"><%= k %></a>
          <% }); %>
        </div>

        <!-- Side-by-Side CTA Buttons -->
        <div class="d-flex flex-wrap gap-3 justify-content-center justify-content-lg-start align-items-center">
          <a class="btn btn-purple-gradient btn-lg px-4 py-2.5 rounded-3 fw-semibold shadow-sm d-inline-flex align-items-center gap-2" href="/opportunities">
            <span>Browse Opportunities</span> <i class="bi bi-arrow-right"></i>
          </a>
          <% if (!currentUser) { %>
            <a class="btn btn-outline-purple btn-lg px-4 py-2.5 rounded-3 fw-semibold d-inline-flex align-items-center gap-2" href="/auth/register?role=company">
              <i class="bi bi-building-add"></i> <span>Post an Opportunity</span>
            </a>
          <% } else if (isCompany) { %>
            <a class="btn btn-outline-purple btn-lg px-4 py-2.5 rounded-3 fw-semibold d-inline-flex align-items-center gap-2" href="/company/opportunities/new">
              <i class="bi bi-plus-circle"></i> <span>Post an Opportunity</span>
            </a>
          <% } else { %>
            <a class="btn btn-outline-purple btn-lg px-4 py-2.5 rounded-3 fw-semibold d-inline-flex align-items-center gap-2" href="/student/dashboard">
              <i class="bi bi-speedometer2"></i> <span>Open Dashboard</span>
            </a>
          <% } %>
        </div>
      </div>

      <!-- HERO RIGHT COLUMN: Realistic Student Photograph + Lavender Backdrop Shapes + 2 Clean Floating Cards -->
      <div class="col-lg-6">
        <div class="hero-photo-wrapper position-relative mx-auto">
          <!-- Subtle lavender decorative backdrop shapes -->
          <div class="hero-photo-backdrop-shape" aria-hidden="true"></div>
          <div class="hero-photo-backdrop-glow" aria-hidden="true"></div>

          <!-- Main Rounded Photograph Container -->
          <div class="hero-photo-frame shadow-2xl position-relative overflow-hidden">
            <img src="/images/nextstep-hero-student.jpg"
                 alt="University student learning and discovering career opportunities on NextStep"
                 class="hero-photo-img"
                 loading="eager"
                 onerror="this.onerror=null; this.src='/img/nextstep-hero-student.jpg';">
            <div class="hero-photo-vignette" aria-hidden="true"></div>
          </div>

          <!-- FLOATING UI CARD 1: "Application Shortlisted" (Bottom-Left) -->
          <div class="hero-floating-card hero-card-shortlisted bg-white p-3 rounded-4 shadow-lg border border-light-subtle d-flex align-items-center gap-3">
            <div class="hero-card-icon rounded-circle bg-success-subtle text-success d-flex align-items-center justify-content-center flex-shrink-0" style="width: 42px; height: 42px;">
              <i class="bi bi-check2-circle fs-4" style="color: #10B981 !important;"></i>
            </div>
            <div class="min-w-0">
              <div class="d-flex align-items-center gap-2 mb-0.5">
                <span class="fw-bold small text-navy">Application Shortlisted</span>
                <span class="badge rounded-pill text-white px-2 py-0.5" style="background-color: #10B981 !important; font-size: 0.65rem;">Active</span>
              </div>
              <div class="text-navy-muted small" style="font-size: 0.75rem;">
                <span class="fw-semibold text-purple">Google</span> &middot; Software Engineering Intern
              </div>
            </div>
          </div>

          <!-- FLOATING UI CARD 2: "Scholarship Approved" (Bottom-Right) -->
          <div class="hero-floating-card hero-card-scholarship bg-white p-3 rounded-4 shadow-lg border border-light-subtle d-flex align-items-center gap-3">
            <div class="hero-card-icon rounded-circle bg-purple-subtle text-purple d-flex align-items-center justify-content-center flex-shrink-0" style="width: 42px; height: 42px;">
              <i class="bi bi-mortarboard-fill fs-5 text-purple"></i>
            </div>
            <div>
              <div class="fw-bold small text-navy mb-0.5">Scholarship Approved</div>
              <div class="small fw-semibold d-flex align-items-center gap-1" style="color: #10B981; font-size: 0.75rem;">
                <i class="bi bi-patch-check-fill"></i> $5,000 Award Granted
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- =========================================================================
     SECTION A. PLATFORM HIGHLIGHTS (Real DB Aggregations, No Fabricated Stats)
     ========================================================================= -->
<section class="platform-highlights-section py-5">
  <div class="container">
    <div class="row g-3 g-lg-4 text-center" id="statsCounters">
      <!-- 1. Available Opportunities -->
      <div class="col-6 col-md-3">
        <div class="highlight-stat-card h-100">
          <div class="highlight-stat-icon bg-indigo-subtle text-indigo mx-auto">
            <i class="bi bi-briefcase-fill"></i>
          </div>
          <div class="highlight-stat-value text-navy">
            <span class="counter-value" data-target="<%= stats.opportunities || 0 %>"><%= stats.opportunities || 0 %></span>+
          </div>
          <div class="highlight-stat-label">Available Opportunities</div>
        </div>
      </div>

      <!-- 2. Verified Internships -->
      <div class="col-6 col-md-3">
        <div class="highlight-stat-card h-100">
          <div class="highlight-stat-icon bg-purple-subtle text-purple mx-auto">
            <i class="bi bi-code-slash"></i>
          </div>
          <div class="highlight-stat-value text-navy">
            <span class="counter-value" data-target="<%= stats.internships || stats.opportunities || 0 %>"><%= stats.internships || stats.opportunities || 0 %></span>+
          </div>
          <div class="highlight-stat-label">Verified Internships</div>
        </div>
      </div>

      <!-- 3. Active Scholarships -->
      <div class="col-6 col-md-3">
        <div class="highlight-stat-card h-100">
          <div class="highlight-stat-icon bg-emerald-subtle text-success mx-auto">
            <i class="bi bi-mortarboard-fill"></i>
          </div>
          <div class="highlight-stat-value text-navy">
            <span class="counter-value" data-target="<%= stats.scholarships || 0 %>"><%= stats.scholarships || 0 %></span>+
          </div>
          <div class="highlight-stat-label">Active Scholarships</div>
        </div>
      </div>

      <!-- 4. Verified Companies -->
      <div class="col-6 col-md-3">
        <div class="highlight-stat-card h-100">
          <div class="highlight-stat-icon bg-cyan-subtle text-info mx-auto">
            <i class="bi bi-building-check"></i>
          </div>
          <div class="highlight-stat-value text-navy">
            <span class="counter-value" data-target="<%= stats.verifiedCompanies || stats.companies || 0 %>"><%= stats.verifiedCompanies || stats.companies || 0 %></span>+
          </div>
          <div class="highlight-stat-label">Verified Companies</div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- =========================================================================
     SECTION B. FEATURED OPPORTUNITIES (Real Approved Opportunities)
     ========================================================================= -->
<section class="featured-opportunities-section py-5 bg-slate-subtle">
  <div class="container py-lg-3">
    <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
      <div>
        <span class="badge bg-purple-subtle text-purple rounded-pill px-3 py-1 fw-semibold text-uppercase small mb-2">Curated Openings</span>
        <h2 class="h3 fw-extrabold text-navy mb-1">Featured Opportunities</h2>
        <p class="text-navy-muted small mb-0">Handpicked internships and funded scholarships from verified institutions.</p>
      </div>
      <a class="btn btn-outline-purple px-4 py-2 rounded-3 fw-semibold small d-inline-flex align-items-center gap-1" href="/opportunities">
        <span>Browse All Opportunities</span> <i class="bi bi-arrow-right"></i>
      </a>
    </div>

    <% if (featured && featured.length) { %>
      <div class="row g-4">
        <% featured.slice(0, 3).forEach(function (o) { %>
          <div class="col-md-6 col-lg-4">
            <%- include('../partials/opportunityCard', { o: o }) %>
          </div>
        <% }); %>
      </div>
    <% } else { %>
      <%- include('../partials/emptyState', {
        emptyState: {
          icon: 'bi-briefcase',
          title: 'No opportunities open right now',
          message: 'New opportunities are reviewed and published daily.',
          actionHref: '/opportunities', actionLabel: 'Explore Open Listings', actionIcon: 'bi-grid'
        }
      }) %>
    <% } %>
  </div>
</section>

<!-- =========================================================================
     SECTION C. EXPLORE BY CATEGORY (Attractive Cards with Pastel Icons)
     ========================================================================= -->
<section class="categories-section py-5">
  <div class="container py-lg-3">
    <div class="text-center max-w-700 mx-auto mb-5">
      <span class="badge bg-purple-subtle text-purple rounded-pill px-3 py-1 fw-semibold text-uppercase small mb-2">Explore Fields</span>
      <h2 class="h3 fw-extrabold text-navy mb-2">Explore by Category</h2>
      <p class="text-navy-muted small mb-0">Find the right internship or scholarship tailored to your academic field and career passions.</p>
    </div>

    <%
    const categoryThemeMap = {
      'Software Development': { icon: 'bi-code-slash', bg: '#DBEAFE', color: '#1D4ED8' },
      'Data Science & AI': { icon: 'bi-database-fill', bg: '#F3E8FF', color: '#7E22CE' },
      'Design': { icon: 'bi-palette-fill', bg: '#FCE7F3', color: '#BE185D' },
      'Marketing': { icon: 'bi-megaphone-fill', bg: '#FEF3C7', color: '#B45309' },
      'Finance': { icon: 'bi-wallet2', bg: '#DCFCE7', color: '#15803D' },
      'Engineering': { icon: 'bi-cpu-fill', bg: '#FFEDD5', color: '#C2410C' },
      'Research': { icon: 'bi-journal-code', bg: '#CCFBF1', color: '#0F766E' },
      'Education': { icon: 'bi-mortarboard-fill', bg: '#E0F2FE', color: '#0369A1' },
      'Business Development': { icon: 'bi-graph-up-arrow', bg: '#E0E7FF', color: '#4338CA' },
      'Human Resources': { icon: 'bi-people-fill', bg: '#F3E8FF', color: '#7E22CE' }
    };
    %>

    <div class="row g-3 row-cols-2 row-cols-md-3 row-cols-lg-5">
      <% (categories || []).slice(0, 10).forEach(function (cat) {
           const theme = categoryThemeMap[cat] || { icon: 'bi-briefcase-fill', bg: '#E0E7FF', color: '#4338CA' };
           const statMatch = (categoryStats || []).find(function (cs) { return cs._id === cat; });
           const count = statMatch ? statMatch.count : 'Multiple';
      %>
        <div class="col">
          <a href="/search?category=<%= encodeURIComponent(cat) %>" class="category-pill-card h-100 text-decoration-none">
            <div class="category-icon-box mb-3" style="width: 52px; height: 52px; border-radius: 14px; background-color: <%= theme.bg %>; color: <%= theme.color %>; display: flex; align-items: center; justify-content: center;">
              <i class="bi <%= theme.icon %> fs-4"></i>
            </div>
            <h3 class="h6 fw-bold text-navy mb-1 text-truncate w-100"><%= cat %></h3>
            <span class="small text-muted"><%= count %> open roles</span>
          </a>
        </div>
      <% }); %>
    </div>
  </div>
</section>

<!-- =========================================================================
     SECTION D. HOW NEXTSTEP WORKS (Discover, Apply, Track)
     ========================================================================= -->
<section class="how-it-works-section py-5 bg-slate-subtle border-top border-bottom">
  <div class="container py-lg-3">
    <div class="text-center max-w-700 mx-auto mb-5">
      <span class="badge bg-purple-subtle text-purple rounded-pill px-3 py-1 fw-semibold text-uppercase small mb-2">Simple 3-Step Process</span>
      <h2 class="h3 fw-extrabold text-navy mb-2">How NextStep Works</h2>
      <p class="text-navy-muted small mb-0">From discovering curated postings to receiving interview calls in three seamless steps.</p>
    </div>

    <div class="row g-4">
      <!-- Step 1: Discover Opportunities -->
      <div class="col-md-4">
        <div class="work-step-card bg-white p-4 p-xl-5 rounded-4 shadow-sm h-100 border border-light-subtle position-relative overflow-hidden transition-hover">
          <div class="step-watermark" aria-hidden="true">01</div>
          <div class="step-icon-wrap rounded-3 mb-4 d-inline-flex align-items-center justify-content-center" style="width: 50px; height: 50px; background: linear-gradient(135deg, #4338CA, #6366F1); color: #fff;">
            <i class="bi bi-search fs-4"></i>
          </div>
          <h3 class="h5 fw-bold text-navy mb-2">1. Discover Opportunities</h3>
          <p class="text-navy-muted small mb-3 lh-base">
            Explore verified internships and prestigious scholarship programs filtered by field, GPA, and skills.
          </p>
          <div class="d-flex align-items-center gap-2 small text-purple fw-semibold">
            <span>Skill Matching</span> &middot; <span>Verified Posts</span>
          </div>
        </div>
      </div>

      <!-- Step 2: Apply with Your CV -->
      <div class="col-md-4">
        <div class="work-step-card bg-white p-4 p-xl-5 rounded-4 shadow-sm h-100 border border-light-subtle position-relative overflow-hidden transition-hover">
          <div class="step-watermark" aria-hidden="true">02</div>
          <div class="step-icon-wrap rounded-3 mb-4 d-inline-flex align-items-center justify-content-center" style="width: 50px; height: 50px; background: linear-gradient(135deg, #7C3AED, #A855F7); color: #fff;">
            <i class="bi bi-file-earmark-person fs-4"></i>
          </div>
          <h3 class="h5 fw-bold text-navy mb-2">2. Apply with Your CV</h3>
          <p class="text-navy-muted small mb-3 lh-base">
            Submit your student profile, personalized cover letter, and resume directly to employers in one click.
          </p>
          <div class="d-flex align-items-center gap-2 small text-purple fw-semibold">
            <span>One-Click CV</span> &middot; <span>Direct Submission</span>
          </div>
        </div>
      </div>

      <!-- Step 3: Track Your Applications -->
      <div class="col-md-4">
        <div class="work-step-card bg-white p-4 p-xl-5 rounded-4 shadow-sm h-100 border border-light-subtle position-relative overflow-hidden transition-hover">
          <div class="step-watermark" aria-hidden="true">03</div>
          <div class="step-icon-wrap rounded-3 mb-4 d-inline-flex align-items-center justify-content-center" style="width: 50px; height: 50px; background: linear-gradient(135deg, #059669, #10B981); color: #fff;">
            <i class="bi bi-clock-history fs-4"></i>
          </div>
          <h3 class="h5 fw-bold text-navy mb-2">3. Track Your Applications</h3>
          <p class="text-navy-muted small mb-3 lh-base">
            Stay informed with real-time status updates, recruiter notifications, and interview invitations.
          </p>
          <div class="d-flex align-items-center gap-2 small text-success fw-semibold">
            <span>Live Timeline</span> &middot; <span>Status Tracking</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- =========================================================================
     SECTION E. FINAL CALL TO ACTION
     ========================================================================= -->
<section class="container py-5 my-3">
  <div class="cta-banner-wrapper text-white p-4 p-lg-5 rounded-5 shadow-2xl position-relative overflow-hidden" style="background: linear-gradient(135deg, #312E81 0%, #4338CA 50%, #6D28D9 100%);">
    <!-- Subtle decorative glow circles -->
    <div class="position-absolute rounded-circle bg-white opacity-10" style="width: 350px; height: 350px; top: -120px; right: -80px; filter: blur(50px);" aria-hidden="true"></div>
    <div class="position-absolute rounded-circle bg-purple opacity-20" style="width: 250px; height: 250px; bottom: -80px; left: -50px; filter: blur(40px);" aria-hidden="true"></div>

    <div class="row align-items-center g-4 position-relative z-1 text-center text-lg-start">
      <div class="col-lg-8">
        <span class="badge rounded-pill bg-white bg-opacity-20 text-white px-3 py-1 mb-3 small fw-semibold text-uppercase">
          <i class="bi bi-stars me-1 text-warning"></i>Accelerate Your Future
        </span>
        <h2 class="display-6 fw-extrabold text-white mb-2">Your next opportunity is waiting. Start exploring today.</h2>
        <p class="text-white text-opacity-85 mb-0 fs-6 max-w-650 lh-base">
          Join thousands of ambitious students and graduates discovering career-launching internships and life-changing scholarships with NextStep.
        </p>
      </div>
      <div class="col-lg-4 text-center text-lg-end">
        <div class="d-flex flex-column flex-sm-row justify-content-lg-end gap-2.5">
          <a class="btn btn-light btn-lg px-4 py-2.5 rounded-3 fw-bold text-navy shadow-sm" href="/opportunities">
            <span>Browse Opportunities</span> <i class="bi bi-arrow-right ms-1"></i>
          </a>
          <% if (!currentUser) { %>
            <a class="btn btn-outline-light btn-lg px-4 py-2.5 rounded-3 fw-semibold" href="/auth/register">
              <span>Create Account</span>
            </a>
          <% } else if (isCompany) { %>
            <a class="btn btn-outline-light btn-lg px-4 py-2.5 rounded-3 fw-semibold" href="/company/opportunities/new">
              <span>Post Opportunity</span>
            </a>
          <% } else { %>
            <a class="btn btn-outline-light btn-lg px-4 py-2.5 rounded-3 fw-semibold" href="/student/dashboard">
              <span>My Dashboard</span>
            </a>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</section>
