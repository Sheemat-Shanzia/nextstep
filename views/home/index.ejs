<%- include('../partials/flash') %>

<!-- ================= HERO ================= -->
<section class="hero-section py-5">
  <div class="container py-lg-4">
    <div class="row justify-content-center">
      <div class="col-lg-10 col-xl-8 text-center">
        <div class="mb-3">
          <img src="/img/logo.png" alt="NextStep Logo" class="hero-logo mb-2">
        </div>
        <span class="badge rounded-pill bg-primary-subtle text-primary border border-primary-subtle mb-3">
          <i class="bi bi-stars me-1"></i>Internships &amp; Scholarships in one place
        </span>
        <h1 class="display-4 fw-bold mb-3">
          Find your next <span class="text-primary">internship</span> or
          <span class="text-success">scholarship</span>.
        </h1>
        <p class="lead text-body-secondary mb-4">
          NextStep connects students with verified companies and organisations. Search thousands of
          opportunities, apply in minutes with your CV, and track every application in one dashboard.
        </p>

        <form class="hero-search mb-3" action="/search" method="get" role="search">
          <div class="input-group input-group-lg">
            <span class="input-group-text bg-body"><i class="bi bi-search"></i></span>
            <input type="search" class="form-control" name="q" autocomplete="off" id="heroSearchInput"
                   placeholder="Job title, skill or company&hellip;" aria-label="Search opportunities">
            <button class="btn btn-primary" type="submit">Search</button>
          </div>
          <div id="heroSuggestions" class="hero-suggestions d-none" role="listbox"></div>
        </form>

        <div class="d-flex flex-wrap gap-2 justify-content-center">
          <span class="small text-body-secondary align-self-center">Popular:</span>
          <% ['Software Engineering', 'Data Science', 'Marketing', 'Design', 'Research'].forEach(function (k) { %>
            <a class="badge rounded-pill text-bg-light border text-decoration-none" href="/search?q=<%= encodeURIComponent(k) %>"><%= k %></a>
          <% }); %>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ================= STATS (from MongoDB aggregations) ================= -->
<section class="py-4 border-top border-bottom bg-body-tertiary">
  <div class="container">
    <div class="row g-3 text-center" id="statsCounters">
      <div class="col-6 col-lg-2">
        <div class="stat-counter"><span class="counter-value" data-target="<%= stats.totalUsersLabel || stats.totalUsers %>"><%= stats.totalUsersLabel || stats.totalUsers %></span></div>
        <div class="stat-counter-label">Registered users</div>
      </div>
      <div class="col-6 col-lg-2">
        <div class="stat-counter"><span class="counter-value" data-target="<%= stats.students %>"><%= stats.students %></span></div>
        <div class="stat-counter-label">Students</div>
      </div>
      <div class="col-6 col-lg-2">
        <div class="stat-counter"><span class="counter-value" data-target="<%= stats.companies %>"><%= stats.companies %></span></div>
        <div class="stat-counter-label">Companies</div>
      </div>
      <div class="col-6 col-lg-2">
        <div class="stat-counter"><span class="counter-value" data-target="<%= stats.opportunities %>"><%= stats.opportunities %></span></div>
        <div class="stat-counter-label">Open opportunities</div>
      </div>
      <div class="col-6 col-lg-2">
        <div class="stat-counter"><span class="counter-value" data-target="<%= stats.applications %>"><%= stats.applications %></span></div>
        <div class="stat-counter-label">Applications sent</div>
      </div>
      <div class="col-6 col-lg-2">
        <div class="stat-counter"><span class="counter-value" data-target="<%= avgRating.count %>"><%= avgRating.count %></span></div>
        <div class="stat-counter-label">Reviews (<%= avgRating.avg || 0 %> &#9733; avg)</div>
      </div>
    </div>
  </div>
</section>

<!-- ================= ANNOUNCEMENTS (bonus 20) ================= -->
<% if (announcements && announcements.length) { %>
  <section class="container mt-4">
    <% announcements.forEach(function (a) { %>
      <div class="alert alert-<%= a.level || 'info' %> d-flex align-items-start gap-2 shadow-sm" role="alert">
        <i class="bi bi-megaphone-fill mt-1"></i>
        <div>
          <strong><%= a.title %></strong>
          <div class="small"><%= a.body %></div>
        </div>
      </div>
    <% }); %>
  </section>
<% } %>

<!-- ================= FEATURED OPPORTUNITIES ================= -->
<section class="container py-5">
  <div class="d-flex justify-content-between align-items-end flex-wrap gap-2 mb-4">
    <div>
      <h2 class="h3 mb-1">Latest opportunities</h2>
      <p class="text-body-secondary mb-0">Freshly approved internships and scholarships.</p>
    </div>
    <a class="btn btn-outline-primary" href="/opportunities">View all <i class="bi bi-arrow-right ms-1"></i></a>
  </div>

  <% if (featured && featured.length) { %>
    <div class="row g-4">
      <% featured.forEach(function (o) { %>
        <div class="col-md-6 col-xl-4">
          <%- include('../partials/opportunityCard', { o: o }) %>
        </div>
      <% }); %>
    </div>
  <% } else { %>
    <%- include('../partials/emptyState', {
      emptyState: {
        icon: 'bi-briefcase',
        title: 'No opportunities published yet',
        message: 'Run "npm run seed" to load the demo dataset.',
        actionHref: '/opportunities', actionLabel: 'Browse', actionIcon: 'bi-grid'
      }
    }) %>
  <% } %>
</section>

<!-- ================= CATEGORIES ================= -->
<% if (categories && categories.length) { %>
<section class="container pb-5">
  <h2 class="h5 mb-3">Browse by category</h2>
  <div class="d-flex flex-wrap gap-2">
    <% categories.forEach(function (c) { %>
      <a class="btn btn-sm btn-outline-secondary" href="/search?category=<%= encodeURIComponent(c) %>"><%= c %></a>
    <% }); %>
  </div>
</section>
<% } %>

<!-- ================= MOST VIEWED + TOP COMPANIES ================= -->
<section class="bg-body-tertiary border-top border-bottom py-5">
  <div class="container">
    <div class="row g-5">
      <div class="col-lg-7">
        <h2 class="h4 mb-3"><i class="bi bi-fire text-danger me-2"></i>Most viewed right now</h2>
        <% if (mostViewed && mostViewed.length) { %>
          <div class="list-group shadow-sm">
            <% mostViewed.forEach(function (o, i) { %>
              <a href="/opportunities/<%= o._id %>" class="list-group-item list-group-item-action d-flex gap-3 align-items-center">
                <span class="rank-badge"><%= i + 1 %></span>
                <span class="flex-grow-1 min-w-0">
                  <span class="d-block fw-semibold text-truncate"><%= o.title %></span>
                  <span class="small text-body-secondary">
                    <%= o.companyNameCopy %>
                    &middot; <%= o.location %>
                    &middot; <span class="text-capitalize"><%= o.type %></span>
                  </span>
                </span>
                <span class="small text-body-secondary text-nowrap"><i class="bi bi-eye"></i> <%= o.views %></span>
              </a>
            <% }); %>
          </div>
        <% } else { %>
          <p class="text-body-secondary small">No data yet.</p>
        <% } %>
      </div>

      <div class="col-lg-5">
        <h2 class="h4 mb-3"><i class="bi bi-building text-primary me-2"></i>Top hiring companies</h2>
        <% if (topCompanies && topCompanies.length) { %>
          <div class="d-grid gap-2">
            <% topCompanies.forEach(function (c) { %>
              <div class="d-flex justify-content-between align-items-center bg-body border rounded p-2 px-3 shadow-sm">
                <span class="fw-semibold text-truncate"><%= c._id %></span>
                <span class="badge text-bg-primary"><%= c.openings %> openings</span>
              </div>
            <% }); %>
          </div>
          <a class="btn btn-outline-secondary btn-sm mt-3" href="/companies">Company directory <i class="bi bi-arrow-right ms-1"></i></a>
        <% } else { %>
          <p class="text-body-secondary small">No companies have published yet.</p>
        <% } %>
      </div>
    </div>
  </div>
</section>

<!-- ================= HOW IT WORKS ================= -->
<section class="container py-5">
  <div class="text-center mb-5">
    <h2 class="h3 mb-1">How NextStep works</h2>
    <p class="text-body-secondary">A simple, moderated workflow from post to placement.</p>
  </div>

  <div class="row g-4">
    <% [
      { icon: 'bi-building-add', n: '01', t: 'Companies post', d: 'Verified companies create internship and scholarship posts with skills, stipend and deadline.' },
      { icon: 'bi-shield-check', n: '02', t: 'Admins approve', d: 'Every post is reviewed by an administrator before students can see it - no spam, no fake jobs.' },
      { icon: 'bi-search', n: '03', t: 'Students search', d: 'Filter by type, location, work mode, stipend, deadline window and required skill.' },
      { icon: 'bi-send-check', n: '04', t: 'Apply with your CV', d: 'Upload your CV once, write a cover letter and track the whole status timeline.' }
    ].forEach(function (s) { %>
      <div class="col-md-6 col-lg-3">
        <div class="card h-100 border-0 shadow-sm how-card">
          <div class="card-body">
            <div class="how-icon mb-3"><i class="bi <%= s.icon %>"></i></div>
            <div class="small text-body-secondary fw-bold mb-1">STEP <%= s.n %></div>
            <h3 class="h6"><%= s.t %></h3>
            <p class="small text-body-secondary mb-0"><%= s.d %></p>
          </div>
        </div>
      </div>
    <% }); %>
  </div>
</section>

<!-- ================= CTA ================= -->
<% if (!currentUser) { %>
<section class="container pb-5">
  <div class="card border-0 bg-primary text-white shadow">
    <div class="card-body p-4 p-lg-5 d-flex flex-column flex-lg-row align-items-center justify-content-between gap-3">
      <div>
        <h2 class="h3 mb-2">Ready to get started?</h2>
        <p class="mb-0 opacity-75">Create a free student account in under a minute, or register your company and start hiring.</p>
      </div>
      <div class="d-flex gap-2 flex-shrink-0">
        <a class="btn btn-light btn-lg" href="/auth/register?role=student"><i class="bi bi-person-badge me-1"></i>I am a student</a>
        <a class="btn btn-outline-light btn-lg" href="/auth/register?role=company"><i class="bi bi-building me-1"></i>I am a company</a>
      </div>
    </div>
  </div>
</section>
<% } %>