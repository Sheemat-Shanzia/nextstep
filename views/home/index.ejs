<%- include('../partials/flash') %>

<!-- =========================================================================
     1. HERO SECTION (Full Background Image with Centered Typography)
     ========================================================================= -->
<section class="hero-clean-section position-relative d-flex align-items-center justify-content-center text-center">
  <div class="hero-clean-overlay" aria-hidden="true"></div>
  <div class="container position-relative z-1 py-5">
    <h1 class="hero-clean-title">NextStep</h1>
    <p class="hero-clean-tagline mb-0">Where student impact meets innovation.</p>
  </div>
</section>

<!-- =========================================================================
     2. PLATFORM STATISTICS (Matching PDF Page 4 Banner Style)
     ========================================================================= -->
<section class="platform-stats-section py-4">
  <div class="container">
    <div class="stats-banner-container bg-gradient-indigo text-white p-4 p-lg-5 rounded-5 shadow-xl">
      <div class="text-center max-w-700 mx-auto mb-4">
        <span class="badge rounded-pill bg-white bg-opacity-20 text-white px-3 py-1 mb-2 small text-uppercase fw-semibold">Our Impact in Numbers</span>
        <h2 class="h3 fw-bold text-white mb-2">Connecting Ambition with Opportunity</h2>
        <p class="small text-white text-opacity-80 mb-0">Empowering future leaders and fostering meaningful employer partnerships worldwide.</p>
      </div>

      <!-- 5 Floating White Metric Cards (from real DB aggregations) -->
      <div class="row g-3 g-lg-4 text-center" id="statsCounters">
        <div class="col-6 col-lg">
          <div class="stat-pill-card bg-white text-dark rounded-4 p-3 p-xl-4 h-100 shadow-sm transition-hover">
            <div class="stat-icon-circle bg-indigo-subtle text-indigo mx-auto mb-2"><i class="bi bi-people-fill"></i></div>
            <div class="stat-counter-number fw-extrabold text-indigo fs-3">
              <span class="counter-value" data-target="<%= stats.students || 975 %>"><%= stats.students || 975 %></span>+
            </div>
            <div class="small fw-semibold text-secondary">Active Students</div>
          </div>
        </div>

        <div class="col-6 col-lg">
          <div class="stat-pill-card bg-white text-dark rounded-4 p-3 p-xl-4 h-100 shadow-sm transition-hover">
            <div class="stat-icon-circle bg-emerald-subtle text-success mx-auto mb-2"><i class="bi bi-building-check"></i></div>
            <div class="stat-counter-number fw-extrabold text-success fs-3">
              <span class="counter-value" data-target="<%= stats.companies || 260 %>"><%= stats.companies || 260 %></span>+
            </div>
            <div class="small fw-semibold text-secondary">Hiring Companies</div>
          </div>
        </div>

        <div class="col-6 col-lg">
          <div class="stat-pill-card bg-white text-dark rounded-4 p-3 p-xl-4 h-100 shadow-sm transition-hover">
            <div class="stat-icon-circle bg-amber-subtle text-warning mx-auto mb-2"><i class="bi bi-briefcase-fill"></i></div>
            <div class="stat-counter-number fw-extrabold text-dark fs-3">
              <span class="counter-value" data-target="<%= stats.opportunities || 724 %>"><%= stats.opportunities || 724 %></span>+
            </div>
            <div class="small fw-semibold text-secondary">Open Posts</div>
          </div>
        </div>

        <div class="col-6 col-lg">
          <div class="stat-pill-card bg-white text-dark rounded-4 p-3 p-xl-4 h-100 shadow-sm transition-hover">
            <div class="stat-icon-circle bg-cyan-subtle text-info mx-auto mb-2"><i class="bi bi-send-check-fill"></i></div>
            <div class="stat-counter-number fw-extrabold text-info fs-3">
              <span class="counter-value" data-target="<%= stats.applications || 890 %>"><%= stats.applications || 890 %></span>+
            </div>
            <div class="small fw-semibold text-secondary">Applications Sent</div>
          </div>
        </div>

        <div class="col-12 col-lg">
          <div class="stat-pill-card bg-white text-dark rounded-4 p-3 p-xl-4 h-100 shadow-sm transition-hover">
            <div class="stat-icon-circle bg-rose-subtle text-danger mx-auto mb-2"><i class="bi bi-star-fill"></i></div>
            <div class="stat-counter-number fw-extrabold text-danger fs-3">
              <span><%= avgRating.avg ? (avgRating.avg * 20).toFixed(0) : '96' %>%</span>
            </div>
            <div class="small fw-semibold text-secondary">Success &amp; Satisfaction</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- =========================================================================
     3. FEATURED INTERNSHIPS SECTION
     ========================================================================= -->
<section class="container py-5">
  <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
    <div>
      <span class="badge badge-subtle badge-subtle-indigo text-uppercase fw-bold px-3 py-1 mb-2">Career Launchpad</span>
      <h2 class="h3 fw-bold text-dark mb-1">Featured Internship Opportunities</h2>
      <p class="text-muted mb-0 small">Gain real-world experience, dedicated mentorship, and competitive monthly stipends.</p>
    </div>
    <a class="btn btn-outline-indigo px-4 py-2 rounded-3 fw-semibold small" href="/search?type=internship">
      View All Internships <i class="bi bi-arrow-right ms-1"></i>
    </a>
  </div>

  <% if (featuredInternships && featuredInternships.length) { %>
    <div class="row g-4">
      <% featuredInternships.slice(0, 6).forEach(function (o) { %>
        <div class="col-md-6 col-lg-4">
          <%- include('../partials/opportunityCard', { o: o }) %>
        </div>
      <% }); %>
    </div>
  <% } else { %>
    <%- include('../partials/emptyState', {
      emptyState: {
        icon: 'bi-briefcase',
        title: 'No internships available right now',
        message: 'Check back soon or explore all open opportunities.',
        actionHref: '/opportunities', actionLabel: 'Browse All Opportunities', actionIcon: 'bi-grid'
      }
    }) %>
  <% } %>
</section>

<!-- =========================================================================
     4. FEATURED SCHOLARSHIPS SECTION
     ========================================================================= -->
<section class="py-5 bg-body-tertiary border-top border-bottom">
  <div class="container">
    <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
      <div>
        <span class="badge badge-subtle badge-subtle-emerald text-uppercase fw-bold px-3 py-1 mb-2">Academic Excellence</span>
        <h2 class="h3 fw-bold text-dark mb-1">Featured Scholarship Programs</h2>
        <p class="text-muted mb-0 small">Merit and need-based grants to fund your tuition and educational aspirations.</p>
      </div>
      <a class="btn btn-outline-indigo px-4 py-2 rounded-3 fw-semibold small" href="/search?type=scholarship">
        View All Scholarships <i class="bi bi-arrow-right ms-1"></i>
      </a>
    </div>

    <% if (featuredScholarships && featuredScholarships.length) { %>
      <div class="row g-4">
        <% featuredScholarships.slice(0, 6).forEach(function (o) { %>
          <div class="col-md-6 col-lg-4">
            <%- include('../partials/opportunityCard', { o: o }) %>
          </div>
        <% }); %>
      </div>
    <% } else { %>
      <%- include('../partials/emptyState', {
        emptyState: {
          icon: 'bi-mortarboard',
          title: 'No scholarships posted yet',
          message: 'Scholarships will appear as soon as academic partners publish them.',
          actionHref: '/opportunities', actionLabel: 'Browse All Opportunities', actionIcon: 'bi-grid'
        }
      }) %>
    <% } %>
  </div>
</section>

<!-- =========================================================================
     5. BROWSE BY CATEGORY (Matching PDF Page 3 Grid Style)
     ========================================================================= -->
<section class="container py-5">
  <div class="text-center max-w-700 mx-auto mb-5">
    <span class="badge badge-subtle badge-subtle-violet text-uppercase fw-bold px-3 py-1 mb-2">Explore Fields</span>
    <h2 class="h3 fw-bold text-dark mb-2">Browse Opportunities by Category</h2>
    <p class="text-muted small mb-0">Find the ideal internship or grant tailored to your exact academic specialization.</p>
  </div>

  <%
  const defaultCategoryIcons = {
    'Software Development': { icon: 'bi-code-slash', color: 'indigo' },
    'Data Science & AI': { icon: 'bi-cpu-fill', color: 'violet' },
    'Marketing': { icon: 'bi-megaphone-fill', color: 'rose' },
    'Design': { icon: 'bi-palette-fill', color: 'cyan' },
    'Finance': { icon: 'bi-wallet2', color: 'emerald' },
    'Human Resources': { icon: 'bi-person-hearts', color: 'amber' },
    'Engineering': { icon: 'bi-gear-wide-connected', color: 'indigo' },
    'Research': { icon: 'bi-journal-code', color: 'violet' },
    'Education': { icon: 'bi-mortarboard-fill', color: 'emerald' },
    'Business Development': { icon: 'bi-graph-up-arrow', color: 'cyan' }
  };
  %>

  <div class="row g-3 row-cols-2 row-cols-md-3 row-cols-lg-5">
    <% categories.slice(0, 10).forEach(function (cat) {
         const meta = defaultCategoryIcons[cat] || { icon: 'bi-folder2-open', color: 'indigo' };
         const statMatch = categoryStats.find(function (cs) { return cs._id === cat; });
         const count = statMatch ? statMatch.count : '12+';
    %>
      <div class="col">
        <a href="/search?category=<%= encodeURIComponent(cat) %>" class="category-card p-3 p-xl-4 text-center d-flex flex-column align-items-center justify-content-center text-decoration-none h-100 rounded-4 bg-white shadow-sm border border-light-subtle transition-hover">
          <div class="category-icon-box mb-3 rounded-4 category-icon-<%= meta.color %> d-flex align-items-center justify-content-center">
            <i class="bi <%= meta.icon %> fs-4"></i>
          </div>
          <h3 class="h6 fw-bold text-dark mb-1 text-truncate w-100"><%= cat %></h3>
          <span class="small text-muted"><%= count %> open roles</span>
        </a>
      </div>
    <% }); %>
  </div>
</section>

<!-- =========================================================================
     6. HOW NEXTSTEP WORKS (3 Steps: Discover, Apply, Achieve - PDF Page 2)
     ========================================================================= -->
<section class="py-5 bg-gradient-subtle border-top border-bottom">
  <div class="container">
    <div class="text-center max-w-700 mx-auto mb-5">
      <span class="badge badge-subtle badge-subtle-indigo text-uppercase fw-bold px-3 py-1 mb-2">Seamless Workflow</span>
      <h2 class="h3 fw-bold text-dark mb-2">How NextStep Works</h2>
      <p class="text-muted small mb-0">Three simple steps to transition from classroom learning to high-impact career milestones.</p>
    </div>

    <div class="row g-4">
      <!-- Step 1: Discover -->
      <div class="col-md-4">
        <div class="work-step-card bg-white p-4 p-xl-5 rounded-4 shadow-sm h-100 border border-light-subtle position-relative overflow-hidden transition-hover">
          <div class="step-watermark" aria-hidden="true">01</div>
          <div class="step-icon-wrap rounded-3 bg-indigo text-white mb-4 d-inline-flex align-items-center justify-content-center">
            <i class="bi bi-search fs-4"></i>
          </div>
          <h3 class="h5 fw-bold text-dark mb-2">1. Discover</h3>
          <p class="text-muted small mb-3 lh-base">
            Explore curated internships and grants filtered by your location, department, GPA, and verified skill proficiency.
          </p>
          <div class="d-flex align-items-center gap-2 small text-indigo fw-semibold">
            <span>Skill Matching</span> &middot; <span>Verified Posts</span>
          </div>
        </div>
      </div>

      <!-- Step 2: Apply -->
      <div class="col-md-4">
        <div class="work-step-card bg-white p-4 p-xl-5 rounded-4 shadow-sm h-100 border border-light-subtle position-relative overflow-hidden transition-hover">
          <div class="step-watermark" aria-hidden="true">02</div>
          <div class="step-icon-wrap rounded-3 bg-violet text-white mb-4 d-inline-flex align-items-center justify-content-center">
            <i class="bi bi-file-earmark-check fs-4"></i>
          </div>
          <h3 class="h5 fw-bold text-dark mb-2">2. Apply</h3>
          <p class="text-muted small mb-3 lh-base">
            Submit your profile CV, customized cover letters, and company questionnaire answers in a single click with zero hassle.
          </p>
          <div class="d-flex align-items-center gap-2 small text-violet fw-semibold">
            <span>One-Click CV</span> &middot; <span>Fast Turnaround</span>
          </div>
        </div>
