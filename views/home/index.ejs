<!-- =========================================================================
     8. STUDENT TESTIMONIALS (Matching PDF Page 1 Testimonials Style)
     ========================================================================= -->
<section class="py-5 bg-body-tertiary border-top border-bottom">
  <div class="container">
    <div class="text-center max-w-700 mx-auto mb-5">
      <span class="badge badge-subtle badge-subtle-indigo text-uppercase fw-bold px-3 py-1 mb-2">Student Voices</span>
      <h2 class="h3 fw-bold text-dark mb-2">What Our Students Are Saying</h2>
      <p class="text-muted small mb-0">Over 95% of students report landing their first internship within 6 weeks of profile completion.</p>
    </div>

    <div class="row g-4">
      <%
      const sampleTestimonials = [
        {
          quote: "NextStep completely streamlined my summer internship search. Within two weeks of uploading my resume, I was interviewed and placed at a top tech consulting firm!",
          name: "Farhan Ahmed",
          role: "Software Engineering Intern",
          university: "University of Dhaka",
          rating: 5,
          initials: "FA"
        },
        {
          quote: "The scholarship search filter is a lifesaver. I was able to secure a merit-based tuition grant that covered my entire final year semester fees without any friction.",
          name: "Tanzina Kabir",
          role: "Merit Scholar Awardee",
          university: "BRAC University",
          rating: 5,
          initials: "TK"
        },
        {
          quote: "I love the live status tracking! Knowing exactly when my application moved to 'Under Review' and 'Shortlisted' kept me motivated and prepared for the interview.",
          name: "Sabbir Hossain",
          role: "Data Analyst Trainee",
          university: "NSU",
          rating: 5,
          initials: "SH"
        }
      ];

      const displayReviews = (reviews && reviews.length >= 3)
        ? reviews.slice(0, 3).map(function (r) {
            return {
              quote: r.comment || "Great experience finding high quality internships and transparent application steps.",
              name: r.student ? r.student.name : "Verified Student",
              role: "Intern Candidate",
              university: "Verified Scholar",
              rating: r.rating || 5,
              initials: r.student && r.student.name ? r.student.name.split(' ').map(function(w){return w[0];}).slice(0,2).join('') : "VS"
            };
          })
        : sampleTestimonials;
      %>

      <% displayReviews.forEach(function (t) { %>
        <div class="col-md-4">
          <div class="testimonial-card p-4 p-xl-4 rounded-4 bg-white shadow-sm border border-light-subtle h-100 d-flex flex-column justify-content-between transition-hover">
            <div>
              <div class="d-flex align-items-center justify-content-between mb-3">
                <div class="text-warning">
                  <% for (let i = 0; i < (t.rating || 5); i++) { %>
                    <i class="bi bi-star-fill small"></i>
                  <% } %>
                </div>
                <i class="bi bi-quote fs-3 text-indigo opacity-35"></i>
              </div>
              <p class="small text-body-secondary mb-4 lh-base italic">
                &ldquo;<%= t.quote %>&rdquo;
              </p>
            </div>

            <div class="d-flex align-items-center gap-3 pt-3 border-top border-light-subtle">
              <div class="avatar avatar-md rounded-circle bg-gradient-indigo text-white fw-bold">
                <%= t.initials %>
              </div>
              <div>
                <div class="fw-bold small text-dark"><%= t.name %></div>
                <div class="text-muted" style="font-size: 0.75rem;"><%= t.role %> &middot; <%= t.university %></div>
              </div>
            </div>
          </div>
        </div>
      <% }); %>
    </div>
  </div>
</section>

<!-- =========================================================================
     9. NEWSLETTER / CAREER ALERTS CTA (Matching PDF Page 1 Newsletter Style)
     ========================================================================= -->
<section class="container py-5 my-2">
  <div class="newsletter-banner bg-gradient-indigo-violet text-white p-4 p-lg-5 rounded-5 shadow-2xl position-relative overflow-hidden">
    <div class="row align-items-center g-4 position-relative z-1">
      <div class="col-lg-6">
        <span class="badge rounded-pill bg-white bg-opacity-25 backdrop-blur px-3 py-1 mb-3 small fw-semibold text-uppercase">
          <i class="bi bi-envelope-paper-fill me-1 text-warning"></i>Weekly Career Dispatch
        </span>
        <h2 class="h3 fw-bold text-white mb-2">Subscribe to Opportunity Alerts</h2>
        <p class="small text-white text-opacity-80 mb-0 pe-lg-3 lh-base">
          Get the newest vetted internships, high-value scholarships, and expert resume tips delivered straight to your inbox every Monday.
        </p>
      </div>

      <div class="col-lg-6">
        <form class="newsletter-form d-flex flex-column flex-sm-row gap-2 bg-white p-2 rounded-4 shadow-lg" onsubmit="event.preventDefault(); this.querySelector('button').innerHTML='<i class=\'bi bi-check2\'></i> Subscribed!'; this.querySelector('input').value='';">
          <input type="email" class="form-control border-0 shadow-none px-3 py-2 text-dark" placeholder="Enter your student email..." required>
          <button class="btn btn-indigo px-4 py-2.5 rounded-3 fw-semibold text-nowrap" type="submit">
            Get Alerts <i class="bi bi-arrow-right ms-1"></i>
          </button>
        </form>
        <div class="small text-white text-opacity-70 mt-2 ps-1" style="font-size: 0.72rem;">
          <i class="bi bi-shield-check me-1"></i>No spam ever. Unsubscribe anytime in one click.
        </div>
      </div>
    </div>
  </div>
</section>
