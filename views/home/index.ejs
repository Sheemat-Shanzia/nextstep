      <!-- Step 3: Achieve -->
      <div class="col-md-4">
        <div class="work-step-card bg-white p-4 p-xl-5 rounded-4 shadow-sm h-100 border border-light-subtle position-relative overflow-hidden transition-hover">
          <div class="step-watermark" aria-hidden="true">03</div>
          <div class="step-icon-wrap rounded-3 bg-emerald text-white mb-4 d-inline-flex align-items-center justify-content-center">
            <i class="bi bi-trophy-fill fs-4"></i>
          </div>
          <h3 class="h5 fw-bold text-dark mb-2">3. Achieve</h3>
          <p class="text-muted small mb-3 lh-base">
            Track live application status milestones, receive interview invitations, review employer notes, and secure your career offer.
          </p>
          <div class="d-flex align-items-center gap-2 small text-success fw-semibold">
            <span>Live Timeline</span> &middot; <span>Direct Feedback</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- =========================================================================
     7. WHY CHOOSE NEXTSTEP (Feature Cards - Matching PDF Page 2)
     ========================================================================= -->
<section class="container py-5">
  <div class="row align-items-center g-5">
    <div class="col-lg-5">
      <span class="badge badge-subtle badge-subtle-indigo text-uppercase fw-bold px-3 py-1 mb-2">Built For You</span>
      <h2 class="h3 fw-bold text-dark mb-3">Designed for the Next Generation of Professionals</h2>
      <p class="text-muted small mb-4 lh-base">
        Unlike generic job boards, NextStep is specifically engineered for students, university career centers, and forward-thinking recruiters who value real potential over decades of experience.
      </p>

      <div class="d-grid gap-3 mb-4">
        <div class="d-flex align-items-start gap-3">
          <div class="feature-check-icon rounded-circle bg-indigo-subtle text-indigo p-2 mt-1">
            <i class="bi bi-check2 fs-6 fw-bold"></i>
          </div>
          <div>
            <h4 class="h6 fw-bold mb-1 text-dark">Strict Moderation &amp; Zero Spam</h4>
