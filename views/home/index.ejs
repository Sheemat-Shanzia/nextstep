<%- include('../partials/flash') %>

<!-- =========================================================================
     1. HERO SECTION (Refined Career-Tech Lavender & Purple Aesthetic)
     ========================================================================= -->
<section class="hero-section position-relative overflow-hidden pt-5 pb-5 pb-lg-6">
  <!-- Subtle gradient blur background orbs -->
  <div class="hero-gradient-orb hero-orb-1" aria-hidden="true"></div>
  <div class="hero-gradient-orb hero-orb-2" aria-hidden="true"></div>

  <div class="container position-relative z-1 py-lg-3">
    <div class="row align-items-center g-5">
      <!-- HERO LEFT COLUMN: Announcement, Headline, Subtitle, Search Bar, Trending, CTAs -->
      <div class="col-lg-6 text-center text-lg-start">
        <!-- Small Announcement Badge -->
        <div class="d-inline-flex align-items-center gap-2 px-3 py-1.5 rounded-pill bg-white shadow-sm border border-purple-subtle mb-3 hero-announcement-badge">
          <span class="pulse-indicator bg-purple"></span>
          <span class="small fw-semibold text-purple">Empowering Students &amp; Graduates</span>
          <i class="bi bi-arrow-right text-purple small"></i>
        </div>

        <!-- Main Headline -->
        <h1 class="display-4 fw-extrabold hero-title text-navy mb-3 lh-sm">
          <span class="text-gradient-purple">NEXTSTEP</span>
        </h1>

        <!-- Subtitle Description -->
        <p class="lead text-navy-muted mb-4 pe-xl-3 hero-subtitle fs-5">
          Where student impact meets innovation
        </p>

        <!-- Large Modern Search Bar -->
        <div class="hero-search-wrapper bg-white p-2 rounded-4 shadow-sm border border-purple-light mb-4">
          <form class="hero-search d-flex flex-column flex-md-row align-items-stretch gap-2" action="/search" method="get" role="search">
            <div class="input-group input-group-lg border-0 flex-grow-1 align-items-center">
              <span class="input-group-text bg-transparent border-0 text-purple ps-3 pe-2">
                <i class="bi bi-search fs-5"></i>
              </span>
              <input type="search" class="form-control border-0 shadow-none px-2 text-navy" name="q" autocomplete="off" id="heroSearchInput"
                     placeholder="Job title, skill or company..." aria-label="Search opportunities">
            </div>
            <div class="vr d-none d-md-block opacity-25 my-2"></div>
            <select class="form-select border-0 shadow-none text-navy-muted py-2 d-none d-sm-block bg-transparent" name="type" style="max-width: 160px; font-weight: 500;">
              <option value="">All Types</option>
              <option value="internship">Internships</option>
              <option value="scholarship">Scholarships</option>
            </select>
            <button class="btn btn-purple-gradient btn-lg px-4 rounded-3 d-flex align-items-center justify-content-center gap-2 fw-semibold" type="submit">
              <span>Search</span> <i class="bi bi-arrow-right"></i>
            </button>
          </form>
          <div id="heroSuggestions" class="hero-suggestions d-none" role="listbox"></div>
        </div>

        <!-- Trending Skill Tags -->
        <div class="d-flex flex-wrap gap-2 justify-content-center justify-content-lg-start align-items-center mb-4">
          <span class="small text-navy-muted fw-semibold me-1"><i class="bi bi-fire text-danger me-1"></i>Trending:</span>
          <% ['Software Engineering', 'Data Science', 'UI/UX Design', 'Marketing', 'FinTech'].forEach(function (k) { %>
            <a class="badge rounded-pill hero-trending-chip text-decoration-none" href="/search?q=<%= encodeURIComponent(k) %>"><%= k %></a>
          <% }); %>
        </div>

        <!-- Two CTA Buttons -->
        <div class="d-flex flex-wrap gap-3 justify-content-center justify-content-lg-start">
          <a class="btn btn-purple-gradient btn-lg px-4 py-2.5 rounded-3 fw-semibold shadow-sm" href="/opportunities">
            <i class="bi bi-grid-fill me-2"></i>Browse All Opportunities
          </a>
          <% if (!currentUser) { %>
            <a class="btn btn-outline-purple btn-lg px-4 py-2.5 rounded-3 fw-semibold" href="/auth/register?role=company">
              <i class="bi bi-building-add me-2"></i>Post an Opportunity
            </a>
          <% } else if (isCompany) { %>
            <a class="btn btn-outline-purple btn-lg px-4 py-2.5 rounded-3 fw-semibold" href="/company/opportunities/new">
              <i class="bi bi-plus-circle me-2"></i>Post an Opportunity
            </a>
          <% } else { %>
            <a class="btn btn-outline-purple btn-lg px-4 py-2.5 rounded-3 fw-semibold" href="/student/dashboard">
              <i class="bi bi-speedometer2 me-2"></i>Open My Dashboard
            </a>
          <% } %>
        </div>
      </div>

      <!-- HERO RIGHT COLUMN: Realistic Student Photo with Background Backdrop & 3 Floating UI Cards -->
      <div class="col-lg-6">
        <div class="hero-photo-wrapper position-relative mx-auto">
          <!-- Subtle cyan/purple backdrop circle shape behind top-left of image (matching Reference Screenshot 2) -->
          <div class="hero-photo-backdrop-shape" aria-hidden="true"></div>

          <!-- Main Rounded Photograph Container -->
          <div class="hero-photo-frame shadow-2xl position-relative overflow-hidden">
            <img src="/images/nextstep-hero-student.jpg"
                 alt="University student learning and discovering career opportunities on NextStep"
                 class="hero-photo-img"
                 loading="eager"
                 onerror="this.onerror=null; this.src='/img/nextstep-hero-student.jpg';">
            <!-- Subtle gradient vignette overlay at the bottom for smooth blending -->
            <div class="hero-photo-vignette" aria-hidden="true"></div>
          </div>

          <!-- FLOATING UI CARD 1: "Application Shortlisted" (Bottom-Left, matching Reference Screenshot 2) -->
          <div class="hero-floating-card hero-card-shortlisted bg-white p-3 rounded-4 shadow-lg border border-light-subtle d-flex align-items-center gap-3">
            <div class="hero-card-icon rounded-circle bg-success-subtle text-success d-flex align-items-center justify-content-center flex-shrink-0" style="width: 44px; height: 44px;">
              <i class="bi bi-check2-circle fs-4" style="color: #15966B !important;"></i>
            </div>
            <div class="min-w-0">
              <div class="d-flex align-items-center gap-2 mb-1">
                <span class="fw-bold small text-navy">Application Shortlisted</span>
                <span class="badge rounded-pill text-white small px-2 py-0.5" style="background-color: #15966B !important; font-size: 0.68rem;">Active</span>
              </div>
              <div class="text-navy-muted small" style="font-size: 0.76rem;">
                <span class="fw-semibold text-purple">Google</span> &middot; Software Engineering Intern
              </div>
            </div>
          </div>

          <!-- FLOATING UI CARD 2: "Browse Opportunities" with small company logos (Top-Right, matching Reference Screenshot 2) -->
          <div class="hero-floating-card hero-card-browse bg-white p-3 rounded-4 shadow-lg border border-light-subtle">
            <div class="d-flex align-items-center justify-content-between gap-3 mb-2">
              <span class="fw-bold small text-navy">Browse Opportunities</span>
              <span class="badge bg-purple-subtle text-purple rounded-pill small" style="font-size: 0.68rem;">250+ New</span>
            </div>
            <!-- Small company brand logos/chips -->
            <div class="d-flex align-items-center gap-1.5">
              <span class="company-mini-logo bg-danger text-white" title="Google"><i class="bi bi-google"></i></span>
              <span class="company-mini-logo bg-primary text-white" title="Microsoft"><i class="bi bi-microsoft"></i></span>
              <span class="company-mini-logo bg-dark text-white" title="Apple"><i class="bi bi-apple"></i></span>
              <span class="company-mini-logo bg-info text-white" title="Intel"><i class="bi bi-cpu-fill"></i></span>
              <span class="company-mini-more small fw-bold text-navy-muted ms-1">+120</span>
            </div>
          </div>

          <!-- FLOATING UI CARD 3: "Scholarship Approved" with icon & award amount (Bottom-Right) -->
          <div class="hero-floating-card hero-card-scholarship bg-white p-3 rounded-4 shadow-lg border border-light-subtle d-flex align-items-center gap-3">
            <div class="hero-card-icon rounded-circle bg-purple-subtle text-purple d-flex align-items-center justify-content-center flex-shrink-0" style="width: 44px; height: 44px;">
              <i class="bi bi-mortarboard-fill fs-5 text-purple"></i>
            </div>
            <div>
              <div class="fw-bold small text-navy">Scholarship Approved</div>
              <div class="small fw-bold d-flex align-items-center gap-1" style="color: #15966B; font-size: 0.78rem;">
                <i class="bi bi-patch-check-fill"></i> $5,000 Award Granted
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- =========================================================================
     2. PLATFORM STATISTICS (Matching PDF Page 4 Banner Style)
     ========================================================================= -->
<section class="platform-stats-section py-4">
  <div class="container">
    <div class="stats-banner-container bg-gradient-indigo text-white p-4 p-lg-5 rounded-5 shadow-xl">
      <div class="text-center max-w-700 mx-auto mb-4">
        <span class="badge rounded-pill bg-white bg-opacity-20 text-white px-3 py-1 mb-2 small text-uppercase fw-semibold">Our Impact in Numbers</span>
        <h2 class="h3 fw-bold text-white mb-2">Connecting Ambition with Opportunity</h2>
        <p class="small text-white text-opacity-80 mb-0">Empowering future leaders and fostering meaningful employer partnerships worldwide.</p>
      </div>

      <!-- 5 Floating White Metric Cards (from real DB aggregations) -->
      <div class="row g-3 g-lg-4 text-center" id="statsCounters">
        <div class="col-6 col-lg">
          <div class="stat-pill-card bg-white text-dark rounded-4 p-3 p-xl-4 h-100 shadow-sm transition-hover">
            <div class="stat-icon-circle bg-indigo-subtle text-indigo mx-auto mb-2"><i class="bi bi-people-fill"></i></div>
            <div class="stat-counter-number fw-extrabold text-indigo fs-3">
              <span class="counter-value" data-target="<%= stats.students || 975 %>"><%= stats.students || 975 %></span>+
            </div>
            <div class="small fw-semibold text-secondary">Active Students</div>
          </div>
        </div>

        <div class="col-6 col-lg">
          <div class="stat-pill-card bg-white text-dark rounded-4 p-3 p-xl-4 h-100 shadow-sm transition-hover">
            <div class="stat-icon-circle bg-emerald-subtle text-success mx-auto mb-2"><i class="bi bi-building-check"></i></div>
            <div class="stat-counter-number fw-extrabold text-success fs-3">
              <span class="counter-value" data-target="<%= stats.companies || 260 %>"><%= stats.companies || 260 %></span>+
            </div>
            <div class="small fw-semibold text-secondary">Hiring Companies</div>
          </div>
        </div>

        <div class="col-6 col-lg">
          <div class="stat-pill-card bg-white text-dark rounded-4 p-3 p-xl-4 h-100 shadow-sm transition-hover">
            <div class="stat-icon-circle bg-amber-subtle text-warning mx-auto mb-2"><i class="bi bi-briefcase-fill"></i></div>
            <div class="stat-counter-number fw-extrabold text-dark fs-3">
              <span class="counter-value" data-target="<%= stats.opportunities || 724 %>"><%= stats.opportunities || 724 %></span>+
            </div>
            <div class="small fw-semibold text-secondary">Open Posts</div>
          </div>
        </div>

        <div class="col-6 col-lg">
          <div class="stat-pill-card bg-white text-dark rounded-4 p-3 p-xl-4 h-100 shadow-sm transition-hover">
            <div class="stat-icon-circle bg-cyan-subtle text-info mx-auto mb-2"><i class="bi bi-send-check-fill"></i></div>
            <div class="stat-counter-number fw-extrabold text-info fs-3">
              <span class="counter-value" data-target="<%= stats.applications || 890 %>"><%= stats.applications || 890 %></span>+
            </div>
            <div class="small fw-semibold text-secondary">Applications Sent</div>
          </div>
        </div>

        <div class="col-12 col-lg">
          <div class="stat-pill-card bg-white text-dark rounded-4 p-3 p-xl-4 h-100 shadow-sm transition-hover">
            <div class="stat-icon-circle bg-rose-subtle text-danger mx-auto mb-2"><i class="bi bi-star-fill"></i></div>
            <div class="stat-counter-number fw-extrabold text-danger fs-3">
              <span><%= avgRating.avg ? (avgRating.avg * 20).toFixed(0) : '96' %>%</span>
            </div>
            <div class="small fw-semibold text-secondary">Success &amp; Satisfaction</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- =========================================================================
     3. FEATURED INTERNSHIPS SECTION
     ========================================================================= -->
<section class="container py-5">
  <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
    <div>
      <span class="badge badge-subtle badge-subtle-indigo text-uppercase fw-bold px-3 py-1 mb-2">Career Launchpad</span>
      <h2 class="h3 fw-bold text-dark mb-1">Featured Internship Opportunities</h2>
      <p class="text-muted mb-0 small">Gain real-world experience, dedicated mentorship, and competitive monthly stipends.</p>
    </div>
    <a class="btn btn-outline-indigo px-4 py-2 rounded-3 fw-semibold small" href="/search?type=internship">
      View All Internships <i class="bi bi-arrow-right ms-1"></i>
    </a>
  </div>

  <% if (featuredInternships && featuredInternships.length) { %>
    <div class="row g-4">
      <% featuredInternships.slice(0, 6).forEach(function (o) { %>
        <div class="col-md-6 col-lg-4">
          <%- include('../partials/opportunityCard', { o: o }) %>
        </div>
      <% }); %>
    </div>
  <% } else { %>
    <%- include('../partials/emptyState', {
      emptyState: {
        icon: 'bi-briefcase',
        title: 'No internships available right now',
        message: 'Check back soon or explore all open opportunities.',
        actionHref: '/opportunities', actionLabel: 'Browse All Opportunities', actionIcon: 'bi-grid'
      }
    }) %>
  <% } %>
</section>

<!-- =========================================================================
     4. FEATURED SCHOLARSHIPS SECTION
     ========================================================================= -->
<section class="py-5 bg-body-tertiary border-top border-bottom">
  <div class="container">
    <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
      <div>
        <span class="badge badge-subtle badge-subtle-emerald text-uppercase fw-bold px-3 py-1 mb-2">Academic Excellence</span>
        <h2 class="h3 fw-bold text-dark mb-1">Featured Scholarship Programs</h2>
        <p class="text-muted mb-0 small">Merit and need-based grants to fund your tuition and educational aspirations.</p>
      </div>
      <a class="btn btn-outline-indigo px-4 py-2 rounded-3 fw-semibold small" href="/search?type=scholarship">
        View All Scholarships <i class="bi bi-arrow-right ms-1"></i>
      </a>
    </div>

    <% if (featuredScholarships && featuredScholarships.length) { %>
      <div class="row g-4">
        <% featuredScholarships.slice(0, 6).forEach(function (o) { %>
          <div class="col-md-6 col-lg-4">
            <%- include('../partials/opportunityCard', { o: o }) %>
          </div>
        <% }); %>
      </div>
    <% } else { %>
      <%- include('../partials/emptyState', {
        emptyState: {
          icon: 'bi-mortarboard',
          title: 'No scholarships posted yet',
          message: 'Scholarships will appear as soon as academic partners publish them.',
          actionHref: '/opportunities', actionLabel: 'Browse All Opportunities', actionIcon: 'bi-grid'
        }
      }) %>
    <% } %>
  </div>
</section>

<!-- =========================================================================
     5. BROWSE BY CATEGORY (Matching PDF Page 3 Grid Style)
     ========================================================================= -->
<section class="container py-5">
  <div class="text-center max-w-700 mx-auto mb-5">
    <span class="badge badge-subtle badge-subtle-violet text-uppercase fw-bold px-3 py-1 mb-2">Explore Fields</span>
    <h2 class="h3 fw-bold text-dark mb-2">Browse Opportunities by Category</h2>
    <p class="text-muted small mb-0">Find the ideal internship or grant tailored to your exact academic specialization.</p>
  </div>

  <%
  const defaultCategoryIcons = {
    'Software Development': { icon: 'bi-code-slash', color: 'indigo' },
    'Data Science & AI': { icon: 'bi-cpu-fill', color: 'violet' },
    'Marketing': { icon: 'bi-megaphone-fill', color: 'rose' },
    'Design': { icon: 'bi-palette-fill', color: 'cyan' },
    'Finance': { icon: 'bi-wallet2', color: 'emerald' },
    'Human Resources': { icon: 'bi-person-hearts', color: 'amber' },
    'Engineering': { icon: 'bi-gear-wide-connected', color: 'indigo' },
    'Research': { icon: 'bi-journal-code', color: 'violet' },
    'Education': { icon: 'bi-mortarboard-fill', color: 'emerald' },
    'Business Development': { icon: 'bi-graph-up-arrow', color: 'cyan' }
  };
  %>

  <div class="row g-3 row-cols-2 row-cols-md-3 row-cols-lg-5">
    <% categories.slice(0, 10).forEach(function (cat) {
         const meta = defaultCategoryIcons[cat] || { icon: 'bi-folder2-open', color: 'indigo' };
         const statMatch = categoryStats.find(function (cs) { return cs._id === cat; });
         const count = statMatch ? statMatch.count : '12+';
    %>
      <div class="col">
        <a href="/search?category=<%= encodeURIComponent(cat) %>" class="category-card p-3 p-xl-4 text-center d-flex flex-column align-items-center justify-content-center text-decoration-none h-100 rounded-4 bg-white shadow-sm border border-light-subtle transition-hover">
          <div class="category-icon-box mb-3 rounded-4 category-icon-<%= meta.color %> d-flex align-items-center justify-content-center">
            <i class="bi <%= meta.icon %> fs-4"></i>
          </div>
          <h3 class="h6 fw-bold text-dark mb-1 text-truncate w-100"><%= cat %></h3>
          <span class="small text-muted"><%= count %> open roles</span>
        </a>
      </div>
    <% }); %>
  </div>
</section>

<!-- =========================================================================
     6. HOW NEXTSTEP WORKS (3 Steps: Discover, Apply, Achieve - PDF Page 2)
     ========================================================================= -->
<section class="py-5 bg-gradient-subtle border-top border-bottom">
  <div class="container">
    <div class="text-center max-w-700 mx-auto mb-5">
      <span class="badge badge-subtle badge-subtle-indigo text-uppercase fw-bold px-3 py-1 mb-2">Seamless Workflow</span>
      <h2 class="h3 fw-bold text-dark mb-2">How NextStep Works</h2>
      <p class="text-muted small mb-0">Three simple steps to transition from classroom learning to high-impact career milestones.</p>
    </div>

    <div class="row g-4">
      <!-- Step 1: Discover -->
      <div class="col-md-4">
        <div class="work-step-card bg-white p-4 p-xl-5 rounded-4 shadow-sm h-100 border border-light-subtle position-relative overflow-hidden transition-hover">
          <div class="step-watermark" aria-hidden="true">01</div>
          <div class="step-icon-wrap rounded-3 bg-indigo text-white mb-4 d-inline-flex align-items-center justify-content-center">
            <i class="bi bi-search fs-4"></i>
          </div>
          <h3 class="h5 fw-bold text-dark mb-2">1. Discover</h3>
          <p class="text-muted small mb-3 lh-base">
            Explore curated internships and grants filtered by your location, department, GPA, and verified skill proficiency.
          </p>
          <div class="d-flex align-items-center gap-2 small text-indigo fw-semibold">
            <span>Skill Matching</span> &middot; <span>Verified Posts</span>
          </div>
        </div>
      </div>

      <!-- Step 2: Apply -->
      <div class="col-md-4">
        <div class="work-step-card bg-white p-4 p-xl-5 rounded-4 shadow-sm h-100 border border-light-subtle position-relative overflow-hidden transition-hover">
          <div class="step-watermark" aria-hidden="true">02</div>
          <div class="step-icon-wrap rounded-3 bg-violet text-white mb-4 d-inline-flex align-items-center justify-content-center">
            <i class="bi bi-file-earmark-check fs-4"></i>
          </div>
          <h3 class="h5 fw-bold text-dark mb-2">2. Apply</h3>
          <p class="text-muted small mb-3 lh-base">
            Submit your profile CV, customized cover letters, and company questionnaire answers in a single click with zero hassle.
          </p>
          <div class="d-flex align-items-center gap-2 small text-violet fw-semibold">
            <span>One-Click CV</span> &middot; <span>Fast Turnaround</span>
          </div>
        </div>
      </div>

      <!-- Step 3: Achieve -->
      <div class="col-md-4">
        <div class="work-step-card bg-white p-4 p-xl-5 rounded-4 shadow-sm h-100 border border-light-subtle position-relative overflow-hidden transition-hover">
          <div class="step-watermark" aria-hidden="true">03</div>
          <div class="step-icon-wrap rounded-3 bg-emerald text-white mb-4 d-inline-flex align-items-center justify-content-center">
            <i class="bi bi-trophy-fill fs-4"></i>
          </div>
          <h3 class="h5 fw-bold text-dark mb-2">3. Achieve</h3>
          <p class="text-muted small mb-3 lh-base">
            Track live application status milestones, receive interview invitations, review employer notes, and secure your career offer.
          </p>
          <div class="d-flex align-items-center gap-2 small text-success fw-semibold">
            <span>Live Timeline</span> &middot; <span>Direct Feedback</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- =========================================================================
     7. WHY CHOOSE NEXTSTEP (Feature Cards - Matching PDF Page 2)
     ========================================================================= -->
<section class="container py-5">
  <div class="row align-items-center g-5">
    <div class="col-lg-5">
      <span class="badge badge-subtle badge-subtle-indigo text-uppercase fw-bold px-3 py-1 mb-2">Built For You</span>
      <h2 class="h3 fw-bold text-dark mb-3">Designed for the Next Generation of Professionals</h2>
      <p class="text-muted small mb-4 lh-base">
        Unlike generic job boards, NextStep is specifically engineered for students, university career centers, and forward-thinking recruiters who value real potential over decades of experience.
      </p>

      <div class="d-grid gap-3 mb-4">
        <div class="d-flex align-items-start gap-3">
          <div class="feature-check-icon rounded-circle bg-indigo-subtle text-indigo p-2 mt-1">
            <i class="bi bi-check2 fs-6 fw-bold"></i>
          </div>
          <div>
            <h4 class="h6 fw-bold mb-1 text-dark">Strict Moderation &amp; Zero Spam</h4>
            <p class="small text-muted mb-0">Every posting is screened by an administrator before appearing to students.</p>
          </div>
        </div>

        <div class="d-flex align-items-start gap-3">
          <div class="feature-check-icon rounded-circle bg-violet-subtle text-violet p-2 mt-1">
            <i class="bi bi-magic fs-6 fw-bold"></i>
          </div>
          <div>
            <h4 class="h6 fw-bold mb-1 text-dark">Smart Skill Compatibility</h4>
            <p class="small text-muted mb-0">Match percentages help you focus effort on roles where you have the highest likelihood of winning.</p>
          </div>
        </div>

        <div class="d-flex align-items-start gap-3">
          <div class="feature-check-icon rounded-circle bg-emerald-subtle text-success p-2 mt-1">
            <i class="bi bi-clock-history fs-6 fw-bold"></i>
          </div>
          <div>
            <h4 class="h6 fw-bold mb-1 text-dark">Full Application Transparency</h4>
            <p class="small text-muted mb-0">Real-time status changes with direct recruiter feedback and in-app notifications.</p>
          </div>
        </div>
      </div>

      <a href="/opportunities" class="btn btn-indigo px-4 py-2.5 rounded-3 fw-semibold small">
        Explore Opportunities Now <i class="bi bi-arrow-right ms-1"></i>
      </a>
    </div>

    <!-- Visual Feature Grid Cards -->
    <div class="col-lg-7">
      <div class="row g-3">
        <div class="col-sm-6">
          <div class="feature-card p-4 rounded-4 bg-white shadow-sm border border-light-subtle h-100 transition-hover">
